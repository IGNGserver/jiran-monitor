---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { CONTENT } from '../i18n/content';
const zh = CONTENT.zh.notFound;
const en = CONTENT.en.notFound;
---

<Base lang="zh" title="404 · 计然 Jiran" noindex>
  <main id="main" class="nf">
    <div class="nf__box">
      <div class="nf__body-wrap">
        <Mark size={48} />
        <p class="nf__code mono">404</p>
        <h1>{zh.title}</h1>
        <p lang="en" class="nf__en">{en.title}</p>
        <p class="nf__body">{zh.body} <span lang="en">{en.body}</span></p>
        <p class="nf__links">
          <a class="btn btn--primary" href="/">{zh.back}</a>
          <a class="btn btn--ghost" href="/en/" lang="en">{en.back}</a>
        </p>
      </div>
    </div>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: var(--void);
  }
  .nf__box {
    width: min(520px, 100%);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-2);
    background: var(--ink-1);
  }
  .nf__body-wrap {
    padding: clamp(32px, 5vw, 48px) 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }
  .nf__code {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 560;
    color: var(--cyan);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  h1 {
    font-family: var(--f-display);
    font-weight: 580;
    font-size: clamp(1.38rem, 2.8vw, 1.85rem);
  }
  .nf__en {
    font-size: 0.96rem;
    color: var(--fg-dim);
  }
  .nf__body {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--fg-faint);
    max-width: 44ch;
  }
  .nf__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 10px;
  }
</style>
