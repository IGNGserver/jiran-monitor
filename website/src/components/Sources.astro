---
import SectionHead from './SectionHead.astro';
import { CONTENT, type Lang } from '../i18n/content';
import { COUNTS, DOCS, TOOLS } from '../data/product';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = CONTENT[lang].sources;
const filters = [
  { key: 'all', label: t.filters.all, n: COUNTS.rows },
  { key: 'u', label: t.filters.u, n: COUNTS.usage },
  { key: 'l', label: t.filters.l, n: COUNTS.limits },
  { key: 's', label: t.filters.s, n: COUNTS.sessions },
];
---

<section class="section sources" id="sources" aria-labelledby="sources-title">
  <div class="wrap">
    <SectionHead index={6} id="sources" kicker={t.kicker} title={t.title} intro={t.intro} />

    <div class="src__controls reveal" role="group" aria-label={t.legend} data-src-filters>
      {filters.map((f, i) => (
        <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={f.key}>
          <span>{f.label}</span><span class="mono src__n">{f.n}</span>
        </button>
      ))}
    </div>

    <ol class="src__wall reveal" data-src-wall data-filter="all">
      {TOOLS.map((tool, i) => (
        <li data-u={tool.u ? '' : undefined} data-l={tool.l ? '' : undefined} data-s={tool.s ? '' : undefined}>
          <span class="src__i mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="src__name">{tool.name}</span>
          <span class="src__caps" aria-label={[tool.u && t.filters.u, tool.l && t.filters.l, tool.s && t.filters.s].filter(Boolean).join(' · ')}>
            <i class:list={{ on: tool.u }}></i><i class:list={{ on: tool.l }}></i><i class:list={{ on: tool.s }}></i>
          </span>
        </li>
      ))}
    </ol>

    <div class="src__foot reveal">
      <span class="note">{t.legend}</span>
      <a href={DOCS.tools} rel="noopener">{t.more} ↗</a>
    </div>
  </div>
</section>

<style>
  .src__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: clamp(48px, 6vw, 80px);
  }
  .src__controls button {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 9px 16px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: none;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.25s;
  }
  .src__controls button:hover {
    border-color: var(--fg);
  }
  .src__controls button[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .src__n {
    font-size: 0.75rem;
    opacity: 0.7;
  }
  .src__wall {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 4px;
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .src__wall li {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 2px 16px 2px 0;
    transition: opacity 0.45s var(--ease-out), color 0.45s;
  }
  .src__i {
    font-size: 0.625rem;
    color: var(--fg-faint);
  }
  .src__name {
    font-family: var(--f-display);
    font-size: clamp(1.25rem, 2.2vw, 1.9rem);
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .src__caps {
    display: inline-flex;
    gap: 3px;
    transform: translateY(-0.6em);
  }
  .src__caps i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    border: 1px solid var(--fg-faint);
  }
  .src__caps i.on {
    background: var(--celadon);
    border-color: var(--celadon);
  }
  .src__wall[data-filter='u'] li:not([data-u]),
  .src__wall[data-filter='l'] li:not([data-l]),
  .src__wall[data-filter='s'] li:not([data-s]) {
    opacity: 0.14;
  }
  .src__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: var(--t-small);
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-src-filters]');
  const wall = document.querySelector<HTMLElement>('[data-src-wall]');
  if (bar && wall) {
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        wall.dataset.filter = b.dataset.filter!;
      }),
    );
  }
</script>
