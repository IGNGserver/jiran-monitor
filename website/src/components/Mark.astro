---
/**
 * 计然 / Jiran 品牌标识（与产品应用图标同构：开口双弧 + 中央 T 字词元标识 + 暖金原点）。
 */
interface Props { size?: number; class?: string }
const { size = 28, class: cls } = Astro.props;
const uid = `jm-${Math.random().toString(36).slice(2, 7)}`;
---
<svg class:list={['mark', cls]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={uid} x1="25" y1="4" x2="6" y2="27" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#eef1f6" />
      <stop offset="0.55" stop-color="#4fc3f7" />
      <stop offset="1" stop-color="#299bd1" />
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="6" fill="#090b10" stroke="rgba(238, 241, 246, 0.2)" stroke-width="1" />
  <path d="M14.65 6.2A9.9 9.9 0 0 0 7.15 20.3" fill="none" stroke={`url(#${uid})`} stroke-width="2.5" stroke-linecap="round" />
  <path d="M17.35 6.2A9.9 9.9 0 0 1 16 25.9V15.1M11.7 15.1h8.6" fill="none" stroke={`url(#${uid})`} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="9.35" cy="22.75" r="2.05" fill="#e5a94c" />
</svg>
