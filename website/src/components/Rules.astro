---
import SectionHead from './SectionHead.astro';
import { CONTENT, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = CONTENT[lang].rules;
---

<section class="section" id="principles" aria-labelledby="rules-title">
  <div class="wrap">
    <SectionHead id="rules-title" index={t.index} title={t.title} lead={t.etymology} />

    <ol class="rules-list">
      {t.items.map((item) => (
        <li class="rule-row glass-card reveal">
          <div class="rule-row__meta">
            <span class="rule-row__no mono">{item.no}</span>
            <code class="rule-row__code">{item.code}</code>
          </div>
          <div class="rule-row__content">
            <h3 class="rule-row__title">{item.title}</h3>
            <p class="rule-row__body">{item.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .rules-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .rule-row {
    padding: clamp(18px, 2.2vw, 24px) clamp(20px, 2.6vw, 28px);
    display: grid;
    grid-template-columns: minmax(240px, 0.85fr) minmax(0, 1.55fr);
    gap: 16px 32px;
    align-items: start;
    transition: border-color 0.2s;
  }

  .rule-row:hover {
    border-color: var(--line-2);
  }

  @media (max-width: 860px) {
    .rule-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
  }

  .rule-row__meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .rule-row__no {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--cyan);
  }

  .rule-row__code {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 0.73rem;
    background: rgb(6 10 20 / 0.8);
    border: 1px solid var(--line);
    color: #93c5fd;
    overflow-wrap: anywhere;
  }

  .rule-row__title {
    font-size: 1.08rem;
    font-weight: 660;
    line-height: 1.35;
    margin-bottom: 6px;
    color: var(--fg);
  }

  .rule-row__body {
    font-size: 0.91rem;
    line-height: 1.66;
    color: var(--fg-dim);
  }
</style>
