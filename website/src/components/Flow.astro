---
import SectionHead from './SectionHead.astro';
import { CONTENT, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = CONTENT[lang].flow;
---

<section class="section section--glow" id="architecture" aria-labelledby="arch-title">
  <div class="wrap">
    <SectionHead id="arch-title" index={t.index} title={t.title} lead={t.lead} />

    <!-- 三阶数据流拓扑 -->
    <ol class="arch-pipeline reveal">
      {t.stages.map((st, idx) => (
        <li class="arch-stage glass-card">
          <div class="arch-stage__top">
            <span class="arch-stage__step mono">{st.step}</span>
            {idx < t.stages.length - 1 && (
              <span class="arch-stage__arrow mono" aria-hidden="true">───▶</span>
            )}
          </div>
          <h3 class="arch-stage__name">{st.name}</h3>
          <p class="arch-stage__tech mono">{st.tech}</p>
          <p class="arch-stage__body">{st.body}</p>
        </li>
      ))}
    </ol>

    <!-- 四端协同矩阵 -->
    <div class="arch-surfaces">
      {t.surfaces.map((sf) => (
        <article class="arch-surface glass-card reveal">
          <span class="arch-surface__badge mono">{sf.badge}</span>
          <h3 class="arch-surface__title">{sf.title}</h3>
          <p class="arch-surface__os mono">{sf.os}</p>
          <p class="arch-surface__desc">{sf.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .arch-pipeline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 22px;
  }

  @media (max-width: 960px) {
    .arch-pipeline {
      grid-template-columns: minmax(0, 1fr);
    }
    .arch-stage__arrow {
      display: none;
    }
  }

  .arch-stage {
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-color: rgb(56 189 248 / 0.2);
  }

  .arch-stage__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .arch-stage__step {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--cyan);
  }

  .arch-stage__arrow {
    font-size: 0.72rem;
    color: rgb(56 189 248 / 0.65);
  }

  .arch-stage__name {
    font-size: 1.18rem;
    font-weight: 680;
    letter-spacing: -0.015em;
  }

  .arch-stage__tech {
    font-size: 0.74rem;
    padding: 4px 9px;
    border-radius: 6px;
    background: rgb(6 10 20 / 0.75);
    border: 1px solid var(--line);
    color: #bae6fd;
    align-self: flex-start;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .arch-stage__body {
    font-size: 0.89rem;
    line-height: 1.65;
    color: var(--fg-dim);
  }

  .arch-surfaces {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  @media (max-width: 1080px) {
    .arch-surfaces {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .arch-surfaces {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .arch-surface {
    padding: 20px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .arch-surface__badge {
    align-self: flex-start;
    padding: 3px 8px;
    border-radius: 5px;
    font-size: 0.67rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    background: rgb(167 139 250 / 0.14);
    border: 1px solid rgb(167 139 250 / 0.3);
    color: #ddd6fe;
  }

  .arch-surface__title {
    font-size: 1.06rem;
    font-weight: 670;
    margin-top: 2px;
  }

  .arch-surface__os {
    font-size: 0.72rem;
    color: var(--cyan);
  }

  .arch-surface__desc {
    font-size: 0.86rem;
    line-height: 1.62;
    color: var(--fg-dim);
  }
</style>
