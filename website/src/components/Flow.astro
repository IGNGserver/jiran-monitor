---
import SectionHead from './SectionHead.astro';
import { CONTENT, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = CONTENT[lang].flow;
const d = t.diagram;
---

<section class="section flow" id="flow" aria-labelledby="flow-title">
  <div class="wrap">
    <SectionHead index={4} id="flow" kicker={t.kicker} title={t.title} intro={t.intro} />

    <figure class="pipe reveal" aria-label={`${d.device} → ${d.collector} → ${d.ingest} → ${d.hub} → ${d.stream} → ${d.readers.join(' / ')}`}>
      <div class="pipe__node pipe__device">
        <span class="note pipe__cap">{d.device} <span class="pipe__times">× N</span></span>
        <ul class="pipe__files mono" aria-hidden="true">
          <li>~/.claude/projects/</li>
          <li>~/.codex/sessions/</li>
          <li>opencode*.db</li>
          <li>…</li>
        </ul>
        <p class="pipe__sub">{d.sources}</p>
        <div class="pipe__inner">
          <span class="pipe__label">{d.collector}</span>
          <span class="note">{d.collectorNote}</span>
        </div>
      </div>

      <div class="pipe__conn" aria-hidden="true"><span class="pipe__line"></span><span class="mono pipe__api">{d.ingest}</span></div>

      <div class="pipe__node pipe__hub">
        <span class="pipe__dial" aria-hidden="true"><i></i></span>
        <span class="pipe__label">{d.hub}</span>
        <span class="note">{d.hubNote}</span>
        <span class="pipe__quota note">{d.quota}</span>
      </div>

      <div class="pipe__conn pipe__conn--out" aria-hidden="true"><span class="pipe__line"></span><span class="mono pipe__api">{d.stream}</span></div>

      <div class="pipe__node pipe__readers">
        {d.readers.map((r) => <span class="pipe__reader">{r}</span>)}
      </div>
    </figure>

    <div class="flow__grid">
      <table class="surfaces reveal">
        <thead>
          <tr>{t.th.map((h, i) => <th scope="col" class={i === 2 ? 'surfaces__hub' : ''}>{h}</th>)}</tr>
        </thead>
        <tbody>
          {t.surfaces.map((s) => (
            <tr>
              <th scope="row"><span class="surfaces__name">{s.name}</span><span class="note">{s.tech}</span></th>
              <td>{s.role}</td>
              <td class="surfaces__hub mono" data-k={t.th[2]}>{s.hub}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <aside class="dest reveal" style="--d:.1s">
        <h3 class="note">{t.destinations.title}</h3>
        <ol>
          {t.destinations.items.map((x, i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span>{x}</li>)}
        </ol>
        <p>{t.destinations.note}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .pipe {
    margin: clamp(56px, 7vw, 96px) 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(90px, 0.7fr) minmax(0, 0.9fr) minmax(90px, 0.7fr) minmax(0, 0.8fr);
    align-items: center;
  }
  .pipe__node {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    border: 1px solid var(--line-2);
    background: var(--bg-2);
  }
  .pipe__device::before,
  .pipe__device::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--line);
    transform: translate(8px, 8px);
    z-index: -1;
  }
  .pipe__device::after {
    transform: translate(16px, 16px);
    opacity: 0.6;
  }
  .pipe__times {
    color: var(--celadon);
  }
  .pipe__files {
    display: grid;
    gap: 2px;
    font-size: 0.75rem;
    color: var(--fg-dim);
  }
  .pipe__sub {
    font-size: var(--t-small);
    color: var(--fg-faint);
  }
  .pipe__inner {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 6px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-left: 2px solid var(--celadon);
  }
  .pipe__label {
    font-family: var(--f-display);
    font-size: 1.3rem;
    line-height: 1.2;
  }
  :lang(zh) .pipe__label {
    font-weight: 600;
    font-size: 1.15rem;
  }
  .pipe__conn {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 0 6px;
  }
  .pipe__line {
    width: 100%;
    height: 2px;
    background-image: repeating-linear-gradient(90deg, var(--celadon) 0 3px, transparent 3px 14px);
    background-size: 28px 2px;
    animation: pipe-flow 1.1s linear infinite;
  }
  .pipe__conn--out .pipe__line {
    background-image: repeating-linear-gradient(90deg, var(--fg) 0 3px, transparent 3px 14px);
  }
  @keyframes pipe-flow {
    to {
      background-position: 28px 0;
    }
  }
  .pipe__api {
    font-size: 0.6875rem;
    color: var(--fg-dim);
    text-align: center;
    word-break: break-all;
  }
  .pipe__hub {
    align-items: center;
    text-align: center;
    border-radius: 999px;
    aspect-ratio: 1;
    justify-content: center;
    max-width: 240px;
    justify-self: center;
    width: 100%;
  }
  .pipe__dial {
    position: relative;
    width: 34px;
    height: 34px;
    border: 1.5px solid var(--fg);
    border-radius: 50%;
    mask: conic-gradient(from 12deg, transparent 0 24deg, #000 24deg);
    animation: dial 12s linear infinite;
  }
  .pipe__dial i {
    position: absolute;
    left: -2px;
    bottom: 2px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cinnabar);
  }
  @keyframes dial {
    to {
      transform: rotate(360deg);
    }
  }
  .pipe__quota {
    position: absolute;
    top: -30px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    color: var(--rule);
  }
  .pipe__readers {
    gap: 10px;
  }
  .pipe__reader {
    padding: 10px 14px;
    border: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .flow__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    margin-top: clamp(72px, 9vw, 120px);
    align-items: start;
  }
  .surfaces {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .surfaces th,
  .surfaces td {
    text-align: left;
    vertical-align: top;
    padding: 16px 12px 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .surfaces thead th {
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
    padding-top: 0;
  }
  .surfaces tbody th {
    font-weight: 400;
    width: 34%;
  }
  .surfaces__name {
    display: block;
    font-family: var(--f-display);
    font-size: 1.25rem;
    line-height: 1.25;
  }
  :lang(zh) .surfaces__name {
    font-weight: 600;
    font-size: 1.1rem;
  }
  .surfaces td {
    color: var(--fg-dim);
  }
  .surfaces .surfaces__hub {
    text-align: right;
    padding-right: 0;
    white-space: nowrap;
  }
  .dest {
    padding: 26px;
    border: 1px solid var(--line);
  }
  .dest ol {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 18px;
    margin: 18px 0 22px;
  }
  .dest li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 1.0625rem;
  }
  .dest li span {
    font-size: var(--t-micro);
    color: var(--cinnabar);
  }
  .dest p {
    font-size: var(--t-small);
    color: var(--fg-dim);
  }

  @media (max-width: 1000px) {
    .pipe {
      grid-template-columns: 1fr;
      max-width: 460px;
    }
    .pipe__conn {
      flex-direction: row;
      height: 76px;
      justify-content: flex-start;
      padding: 0 0 0 28px;
    }
    .pipe__line {
      width: 2px;
      height: 100%;
      background-image: repeating-linear-gradient(180deg, var(--celadon) 0 3px, transparent 3px 14px);
      background-size: 2px 28px;
      animation-name: pipe-flow-v;
    }
    .pipe__conn--out .pipe__line {
      background-image: repeating-linear-gradient(180deg, var(--fg) 0 3px, transparent 3px 14px);
    }
    .pipe__api {
      text-align: left;
    }
    .pipe__hub {
      aspect-ratio: auto;
      border-radius: 0;
      max-width: none;
      align-items: flex-start;
      text-align: left;
      margin-top: 30px;
    }
    .pipe__quota {
      left: 0;
      transform: none;
    }
    .pipe__readers {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .flow__grid {
      grid-template-columns: 1fr;
    }
  }
  @keyframes pipe-flow-v {
    to {
      background-position: 0 28px;
    }
  }
  @media (max-width: 560px) {
    .surfaces thead {
      display: none;
    }
    .surfaces tr {
      display: grid;
      grid-template-columns: 1fr auto;
      border-bottom: 1px solid var(--line);
      padding: 14px 0;
    }
    .surfaces th,
    .surfaces td {
      border: 0;
      padding: 0;
    }
    .surfaces tbody th {
      width: auto;
    }
    .surfaces td:not(.surfaces__hub) {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 8px;
    }
    .surfaces .surfaces__hub {
      grid-column: 2;
      grid-row: 1;
    }
    .surfaces td.surfaces__hub::before {
      content: attr(data-k) ' · ';
      color: var(--fg-faint);
    }
  }
</style>
