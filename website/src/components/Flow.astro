---
import ModelStage from './ModelStage.astro';
import { CONTENT, type Lang } from '../i18n/content';
import { DOCS } from '../data/product';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = CONTENT[lang].flow;
const zh = lang === 'zh';
---

<section class="section" id="architecture" aria-labelledby="flow-title">
  <div class="wrap">
    <header class="sec-head reveal">
      <div class="sec-head__left">
        <span class="eyebrow">{t.index}</span>
        <h2 class="sec-title" id="flow-title">{t.title}</h2>
      </div>
      <p class="sec-lead">{t.lead}</p>
    </header>

    <!-- 多端词元增量同步三维示意图 -->
    <div class="flow-model reveal">
      <ModelStage id="hub" aspect="wide" alt={t.stageAlt} caption={t.stageCaption} />
    </div>

    <!-- 交互式同步模式与离线状态沙盒 -->
    <div
      class="flow-box reveal"
      data-flow
      data-lang={lang}
    >
      <div class="flow-box__bar">
        <div class="flow-box__title mono">
          <span class="flow-box__dot"></span>
          <span>{t.simTitle}</span>
        </div>

        <div class="flow-box__controls">
          <div class="flow-modes mono" role="group" aria-label={zh ? '同步拓扑模式' : 'Sync mode'}>
            <button type="button" class="flow-mode is-active" data-flow-mode="fleet" aria-pressed="true">
              {t.modeFleet}
            </button>
            <button type="button" class="flow-mode" data-flow-mode="local" aria-pressed="false">
              {t.modeLocal}
            </button>
          </div>

          <button
            type="button"
            class="flow-stale-btn mono"
            data-flow-stale
            data-label-sleep={t.staleBtn}
            data-label-wake={t.wakeBtn}
          >
            {t.staleBtn}
          </button>
        </div>
      </div>

      <div class="flow-stage">
        <!-- 左栏：4 台采集设备端 -->
        <ul class="flow-nodes flow-nodes--src mono" aria-label={zh ? '采集设备端' : 'Producer devices'}>
          <li>
            <span class="flow-node__name">MacBook-Pro-M4</span>
            <span class="flow-node__meta" data-flow-mac-state data-state="live">LIVE · 1.5s</span>
          </li>
          <li>
            <span class="flow-node__name">Win11 + \\wsl$</span>
            <span class="flow-node__meta" data-state="live">Worker Scan</span>
          </li>
          <li>
            <span class="flow-node__name">Ubuntu-GPU-Node</span>
            <span class="flow-node__meta" data-state="live">Headless CLI</span>
          </li>
          <li>
            <span class="flow-node__name">ThinkPad-Arch</span>
            <span class="flow-node__meta" data-state="stale">STALE &gt;10m</span>
          </li>
        </ul>

        <!-- 中央数据流画布 -->
        <div class="flow-canvas-wrap">
          <canvas class="flow-canvas" data-flow-canvas aria-label={t.gateNote}></canvas>
        </div>

        <!-- 右栏：4 大查看端 -->
        <ul class="flow-nodes flow-nodes--dst mono" aria-label={zh ? '四端查看界面' : 'Viewer surfaces'}>
          <li>
            <span class="flow-node__name">Desktop App</span>
            <span class="flow-node__meta">Local / SSE</span>
          </li>
          <li>
            <span class="flow-node__name">Hub Web PWA</span>
            <span class="flow-node__meta">HttpOnly Cookie</span>
          </li>
          <li>
            <span class="flow-node__name">Android + 5 Widgets</span>
            <span class="flow-node__meta">Bearer jrs_</span>
          </li>
          <li>
            <span class="flow-node__name">CSV / Model Compare</span>
            <span class="flow-node__meta">models.dev + FX</span>
          </li>
        </ul>
      </div>

      <div class="flow-box__foot mono">
        <p
          class="flow-status"
          data-flow-status
          data-msg-normal={t.gateNote}
          data-msg-local={t.localBypassNote}
          data-msg-stale={t.staleActiveNote}
        >
          {t.gateNote}
        </p>
        <span class="flow-egress" data-flow-egress>2.4 KB/s → 127.0.0.1:17321</span>
      </div>
    </div>

    <!-- 本地保留 vs 自建 Hub 隐私边界双栏表 -->
    <div class="priv-ledger reveal">
      <div class="priv-col priv-col--stay">
        <div class="priv-col__head">
          <span class="eyebrow">{t.staySub}</span>
          <h3>{t.stayTitle}</h3>
        </div>
        <dl class="priv-list">
          {t.stay.map((item, idx) => (
            <div class="priv-row">
              <dt>
                <span class="mono priv-row__idx">0{idx + 1}</span>
                <strong>{item.k}</strong>
              </dt>
              <dd>{item.d}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="priv-col priv-col--hub">
        <div class="priv-col__head">
          <span class="eyebrow eyebrow--brass">{t.hubSub}</span>
          <h3>{t.hubTitle}</h3>
        </div>
        <dl class="priv-list">
          {t.hub.map((item, idx) => (
            <div class="priv-row">
              <dt>
                <span class="mono priv-row__idx priv-row__idx--brass">0{idx + 1}</span>
                <strong>{item.k}</strong>
              </dt>
              <dd>{item.d}</dd>
            </div>
          ))}
        </dl>
        <div class="priv-foot">
          <p>{t.siteFoot}</p>
          <a class="mono priv-doc" href={DOCS.privacy} rel="noopener">{t.docLink}</a>
        </div>
      </div>
    </div>

    <!-- 四端形态卡片 -->
    <div class="surf-grid reveal">
      {t.surfaces.map((s) => (
        <article class="surf-card">
          <div class="surf-card__top mono">
            <span>{s.badge}</span>
          </div>

          <div class="surf-card__wire" aria-hidden="true">
            {s.id === 'desktop' && (
              <svg viewBox="0 0 180 64" fill="none">
                <rect x="6" y="6" width="168" height="52" rx="3" stroke="currentColor" stroke-opacity="0.32" />
                <line x1="46" y1="6" x2="46" y2="58" stroke="currentColor" stroke-opacity="0.24" />
                <rect x="54" y="14" width="48" height="14" rx="2" stroke="#4fc3f7" stroke-opacity="0.8" />
                <rect x="108" y="14" width="58" height="14" rx="2" stroke="#e5a94c" stroke-opacity="0.75" />
                <path d="M54 46 L76 38 L98 43 L122 33 L146 36 L166 29" stroke="#4fc3f7" stroke-width="1.3" />
              </svg>
            )}
            {s.id === 'pwa' && (
              <svg viewBox="0 0 180 64" fill="none">
                <rect x="6" y="6" width="168" height="52" rx="3" stroke="currentColor" stroke-opacity="0.32" />
                <line x1="6" y1="18" x2="174" y2="18" stroke="currentColor" stroke-opacity="0.22" />
                <circle cx="15" cy="12" r="2" fill="#4fc3f7" />
                <rect x="16" y="25" width="68" height="24" rx="2" stroke="#4fc3f7" stroke-opacity="0.65" />
                <rect x="92" y="25" width="72" height="24" rx="2" stroke="currentColor" stroke-opacity="0.28" stroke-dasharray="3 2" />
              </svg>
            )}
            {s.id === 'agent' && (
              <svg viewBox="0 0 180 64" fill="none">
                <rect x="6" y="6" width="168" height="52" rx="3" stroke="currentColor" stroke-opacity="0.32" />
                <path d="M18 22 L25 27 L18 32" stroke="#4fc3f7" stroke-width="1.4" />
                <line x1="30" y1="32" x2="72" y2="32" stroke="#4fc3f7" stroke-width="1.4" />
                <line x1="18" y1="44" x2="148" y2="44" stroke="currentColor" stroke-opacity="0.28" stroke-dasharray="4 3" />
                <circle cx="158" cy="24" r="3" fill="#e5a94c" />
              </svg>
            )}
            {s.id === 'android' && (
              <svg viewBox="0 0 180 64" fill="none">
                <rect x="16" y="6" width="38" height="52" rx="4" stroke="currentColor" stroke-opacity="0.38" />
                <circle cx="35" cy="27" r="10" stroke="#4fc3f7" stroke-width="1.3" stroke-dasharray="44 18" />
                <rect x="66" y="8" width="46" height="22" rx="2.5" stroke="#4fc3f7" stroke-opacity="0.65" />
                <rect x="118" y="8" width="46" height="22" rx="2.5" stroke="#e5a94c" stroke-opacity="0.65" />
                <rect x="66" y="36" width="98" height="22" rx="2.5" stroke="currentColor" stroke-opacity="0.28" />
              </svg>
            )}
          </div>

          <h3 class="surf-card__title">{s.title}</h3>
          <p class="surf-card__os mono">{s.os}</p>
          <p class="surf-card__desc">{s.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .flow-model {
    margin-bottom: 24px;
  }

  .flow-box {
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-2);
    background: var(--ink-1);
    overflow: hidden;
    margin-bottom: 28px;
  }

  .flow-box__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--ink-2);
  }

  .flow-box__title {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.72rem;
    color: var(--fg-dim);
  }

  .flow-box__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px rgb(79 195 247 / 0.65);
  }

  .flow-box__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .flow-modes {
    display: inline-flex;
    flex-wrap: wrap;
    padding: 2px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-2);
    background: var(--void);
    gap: 2px;
  }

  .flow-mode {
    padding: 5px 11px;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: var(--fg-dim);
    font-size: 0.72rem;
    cursor: pointer;
    transition: background 0.18s, color 0.18s;
  }

  .flow-mode.is-active {
    background: var(--fg);
    color: var(--void);
    font-weight: 600;
  }

  .flow-stale-btn {
    padding: 6px 11px;
    border-radius: var(--radius-sm);
    border: 1px solid rgb(229 169 76 / 0.4);
    background: rgb(229 169 76 / 0.1);
    color: var(--brass);
    font-size: 0.72rem;
    cursor: pointer;
    transition: background 0.18s, border-color 0.18s, color 0.18s;
  }

  .flow-stale-btn:hover {
    border-color: var(--brass);
    background: rgb(229 169 76 / 0.18);
  }

  .flow-stale-btn.is-stale {
    border-color: var(--cyan);
    background: var(--cyan-soft);
    color: var(--cyan);
  }

  .flow-stage {
    display: grid;
    grid-template-columns: 204px minmax(0, 1fr) 204px;
    align-items: stretch;
    min-height: 288px;
  }

  @media (max-width: 960px) {
    .flow-stage {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .flow-nodes {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    padding: 14px;
    gap: 8px;
    background: rgb(9 11 16 / 0.55);
  }

  .flow-nodes--src {
    border-right: 1px solid var(--line);
  }

  .flow-nodes--dst {
    border-left: 1px solid var(--line);
  }

  @media (max-width: 960px) {
    .flow-nodes {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .flow-nodes--src {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .flow-nodes--dst {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 520px) {
    .flow-nodes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .flow-nodes li {
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--ink-1);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .flow-node__name {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--fg);
  }

  .flow-node__meta {
    font-size: 0.64rem;
    color: var(--fg-faint);
  }

  .flow-node__meta[data-state='live'] {
    color: var(--cyan);
  }

  .flow-node__meta[data-state='stale'] {
    color: var(--fg-faint);
  }

  .flow-canvas-wrap {
    position: relative;
    min-height: 256px;
    background: #0a0d14;
  }

  .flow-canvas {
    width: 100%;
    height: 100%;
    min-height: 256px;
  }

  .flow-box__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    font-size: 0.72rem;
    color: var(--fg-dim);
  }

  .flow-status[data-tone='cyan'] {
    color: var(--cyan);
  }

  .flow-status[data-tone='stale'] {
    color: var(--brass);
  }

  .flow-egress {
    color: var(--cyan);
    font-size: 0.7rem;
  }

  /* 隐私边界双栏表 */
  .priv-ledger {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 28px;
  }

  @media (max-width: 900px) {
    .priv-ledger {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .priv-col {
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-2);
    background: var(--ink-1);
    padding: clamp(22px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .priv-col__head {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .priv-col__head h3 {
    font-family: var(--f-display);
    font-weight: 580;
    font-size: clamp(1.18rem, 1.7vw, 1.44rem);
    color: var(--fg);
  }

  .priv-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .priv-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .priv-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .priv-row dt {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--fg);
  }

  .priv-row__idx {
    font-size: 0.68rem;
    color: var(--cyan);
  }

  .priv-row__idx--brass {
    color: var(--brass);
  }

  .priv-row dd {
    padding-left: 26px;
    font-size: 0.83rem;
    line-height: 1.64;
    color: var(--fg-dim);
  }

  .priv-foot {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--fg-faint);
  }

  .priv-doc {
    color: var(--cyan);
    font-size: 0.75rem;
    text-decoration: none;
  }
  .priv-doc:hover {
    text-decoration: underline;
  }

  /* 四端形态卡片 */
  .surf-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  @media (max-width: 1040px) {
    .surf-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .surf-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .surf-card {
    border-radius: var(--radius-md);
    border: 1px solid var(--line-2);
    background: var(--ink-1);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .surf-card:hover {
    background: var(--ink-2);
    border-color: var(--line-3);
  }

  .surf-card__top {
    font-size: 0.68rem;
    color: var(--cyan);
  }

  .surf-card__wire {
    color: var(--fg);
    background: var(--void);
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    padding: 6px;
  }

  .surf-card__wire svg {
    width: 100%;
    height: auto;
  }

  .surf-card__title {
    font-family: var(--f-display);
    font-weight: 580;
    font-size: 1.02rem;
    color: var(--fg);
  }

  .surf-card__os {
    font-size: 0.7rem;
    color: var(--fg-faint);
  }

  .surf-card__desc {
    font-size: 0.82rem;
    line-height: 1.62;
    color: var(--fg-dim);
  }
</style>

<script>
  import { initFlowSandbox } from '../scripts/flow';
  document.querySelectorAll<HTMLElement>('[data-flow]').forEach((el) => initFlowSandbox(el));
</script>
