---
import Mark from './Mark.astro';
import { CONTENT, type Lang } from '../i18n/content';
import { CLIENT_ICON_URLS } from '../data/icons';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = CONTENT[lang].workbench;
const zh = lang === 'zh';
---

<section class="section section--alt workbench-sec" id="workbench" aria-labelledby="workbench-title">
  <div class="wrap">
    <header class="sec-head reveal">
      <div class="sec-head__left">
        <span class="eyebrow">{t.index}</span>
        <h2 class="sec-title" id="workbench-title">{t.title}</h2>
      </div>
      <p class="sec-lead">{t.lead}</p>
    </header>

    <div class="wb-tour reveal" role="group" aria-label={t.scenariosLabel}>
      {t.scenarios.map((sc, idx) => (
        <button type="button" class:list={['wb-tour__btn', idx === 0 && 'is-active']} data-wb-scenario={sc.id}>
          <span class="wb-tour__label mono">{sc.label}</span>
          <span class="wb-tour__desc">{sc.desc}</span>
        </button>
      ))}
    </div>

    <div class="wb-frame reveal" data-workbench data-lang={lang} data-wb-theme="dark">
      <!-- 窗口顶部装饰栏（模拟桌面端原生材质标题栏 + 实机演示铭牌） -->
      <div class="wb-window-bar">
        <div class="wb-traffic" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="wb-demo-pill mono">
          <span class="wb-demo-dot"></span>
          <span>{t.demoBadge}</span>
        </div>
        <div class="wb-win-controls">
          <button type="button" class="wb-ctrl-btn mono" data-wb-currency title="Switch display currency">USD</button>
          <button type="button" class="wb-ctrl-btn mono" data-wb-theme-toggle title="Toggle Fluent 2 theme">{zh ? '深色' : 'Dark'}</button>
          <button type="button" class="wb-ctrl-btn mono" data-wb-pulse title="Simulate incoming SSE tick">{zh ? '+ 推送帧' : '+ SSE Tick'}</button>
        </div>
      </div>

      <!-- 真实产品双栏壳体（216px Fluent 2 导航轨 + 主工作区） -->
      <div class="wb-shell">
        <aside class="wb-sidebar" aria-label={zh ? '演示界面导航' : 'Demo navigation'}>
          <div class="wb-brand">
            <Mark size={26} />
            <div>
              <div class="wb-brand__name">{zh ? '计然' : 'Jiran'}</div>
              <div class="wb-brand__sub">{zh ? 'Hub 仪表板' : 'Hub dashboard'}</div>
            </div>
          </div>

          <div class="wb-nav-group">
            <span class="wb-nav-label">{zh ? '分析' : 'Insights'}</span>
            <button type="button" class="wb-nav-item is-active" data-wb-nav="overview">{zh ? '总览' : 'Overview'}</button>
            <button type="button" class="wb-nav-item" data-wb-nav="usage">{zh ? '使用情况' : 'Usage'}</button>
            <button type="button" class="wb-nav-item" data-wb-nav="trends">{zh ? '趋势' : 'Trends'}</button>
          </div>

          <div class="wb-nav-group">
            <span class="wb-nav-label">{zh ? '资源' : 'Resources'}</span>
            <button type="button" class="wb-nav-item" data-wb-nav="devices">{zh ? '设备' : 'Devices'}</button>
            <button type="button" class="wb-nav-item" data-wb-nav="limits">{zh ? '额度' : 'Limits'}</button>
          </div>

          <div class="wb-nav-group">
            <span class="wb-nav-label">{zh ? '管理' : 'Administration'}</span>
            <button type="button" class="wb-nav-item" data-wb-nav="settings">{zh ? '管理' : 'Management'}</button>
          </div>

          <div class="wb-sidebar-foot">
            <span class="wb-stream-dot" data-wb-stream-dot data-tone="live"></span>
            <span class="wb-stream-label mono" data-wb-stream-text>{zh ? 'Hub 实时流在线 · detail=slim' : 'Hub stream live · detail=slim'}</span>
          </div>
        </aside>

        <div class="wb-workspace">
          <!-- Topbar + Scope Commandbar -->
          <div class="wb-topbar">
            <div>
              <h3 class="wb-page-title" data-wb-title>{zh ? '总览' : 'Overview'}</h3>
              <p class="wb-page-meta mono" data-wb-meta></p>
            </div>

            <div class="wb-commandbar">
              <label class="wb-dev-filter">
                <span class="sr-only">{zh ? '筛选设备' : 'Filter device'}</span>
                <select class="wb-select" data-wb-device>
                  <option value="all">{zh ? '全部设备 (4)' : 'All devices (4)'}</option>
                  <option value="mac-m4">MacBook-Pro-M4</option>
                  <option value="win-wsl">Win11-Workstation (WSL2)</option>
                  <option value="gpu-srv">Ubuntu-GPU-Node</option>
                  <option value="arch-tp">ThinkPad-Arch (Stale)</option>
                </select>
              </label>

              <div class="wb-periods" role="group" aria-label={zh ? '统计窗口' : 'Time window'}>
                <button type="button" class="wb-period is-active" data-wb-period="today">{zh ? '今日' : 'Day'}</button>
                <button type="button" class="wb-period" data-wb-period="yesterday">{zh ? '昨天' : 'Yesterday'}</button>
                <button type="button" class="wb-period" data-wb-period="week">{zh ? '本周' : 'Week'}</button>
                <button type="button" class="wb-period" data-wb-period="month">{zh ? '本月' : 'Month'}</button>
                <button type="button" class="wb-period" data-wb-period="allTime">{zh ? '累计' : 'Total'}</button>
              </div>
            </div>
          </div>

          <!-- 动态视图挂载区 -->
          <div class="wb-main" data-wb-main></div>
        </div>
      </div>

      <script type="application/json" data-wb-icons set:html={JSON.stringify(CLIENT_ICON_URLS)} />
    </div>

    <p class="wb-footnote mono reveal">{t.deferNote}</p>
  </div>
</section>

<style is:global>
  .wb-tour {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    background: var(--line);
    border-radius: var(--radius-md);
    border: 1px solid var(--line-2);
    gap: 1px;
    margin-bottom: 16px;
    overflow: hidden;
  }

  @media (max-width: 980px) {
    .wb-tour {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 540px) {
    .wb-tour {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .wb-tour__btn {
    text-align: left;
    padding: 14px 16px;
    border-radius: 0;
    border: 0;
    background: var(--ink-1);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 5px;
    transition: background 0.18s var(--ease);
  }

  .wb-tour__btn:hover {
    background: var(--ink-2);
  }

  .wb-tour__btn.is-active {
    background: var(--ink-3);
    box-shadow: 0 -2px 0 0 var(--cyan) inset;
  }

  .wb-tour__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--cyan);
  }

  .wb-tour__desc {
    font-size: 0.78rem;
    line-height: 1.48;
    color: var(--fg-dim);
  }

  /* Fluent 2 真实令牌映射（支持深色与浅色一键切换） */
  .wb-frame {
    --wb-bg: #121316;
    --wb-elevated: #1b1d22;
    --wb-soft: #16181d;
    --wb-text: #f2f4f8;
    --wb-muted: #9ca3af;
    --wb-line: #2c3038;
    --wb-brand: #56ccf2;
    --wb-brand-bg: rgba(86, 204, 242, 0.13);
    --wb-bar: #56ccf2;
    --wb-good: #56ccf2;
    --wb-warn: #e5a94c;
    --wb-bad: #ef5a52;

    border-radius: var(--radius-lg);
    border: 1px solid var(--line-2);
    background: var(--wb-bg);
    color: var(--wb-text);
    box-shadow: 0 36px 90px -28px rgb(0 0 0 / 0.92);
    overflow: hidden;
  }

  .wb-frame[data-wb-theme='light'] {
    --wb-bg: #f4f5f7;
    --wb-elevated: #ffffff;
    --wb-soft: #eef0f4;
    --wb-text: #1f2328;
    --wb-muted: #57606a;
    --wb-line: #d8dee4;
    --wb-brand: #0f6cbd;
    --wb-brand-bg: #ebf3fc;
    --wb-bar: #0f6cbd;
    --wb-good: #0f6cbd;
    --wb-warn: #b45309;
    --wb-bad: #b91c1c;
  }

  .wb-window-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 16px;
    background: #080a0e;
    color: var(--fg-dim);
    border-bottom: 1px solid var(--line-2);
  }

  .wb-traffic {
    display: inline-flex;
    gap: 6px;
  }

  .wb-traffic span {
    width: 8px;
    height: 8px;
    border-radius: 1px;
    background: #272b34;
    border: 1px solid rgb(255 255 255 / 0.14);
  }
  .wb-traffic span:nth-child(1) { background: rgb(255 255 255 / 0.22); }
  .wb-traffic span:nth-child(2) { background: rgb(229 169 76 / 0.45); }
  .wb-traffic span:nth-child(3) { background: rgb(86 204 242 / 0.55); }

  .wb-demo-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: var(--fg-dim);
  }

  .wb-demo-dot {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
  }

  .wb-win-controls {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .wb-ctrl-btn {
    padding: 3px 9px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-2);
    background: var(--ink-2);
    color: var(--fg);
    font-size: 0.69rem;
    cursor: pointer;
  }

  .wb-ctrl-btn:hover {
    border-color: var(--cyan);
    color: #ffffff;
  }

  .wb-shell {
    display: grid;
    grid-template-columns: 208px minmax(0, 1fr);
    min-height: 590px;
  }

  @media (max-width: 920px) {
    .wb-shell {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .wb-sidebar {
    background: var(--wb-soft);
    border-right: 1px solid var(--wb-line);
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .wb-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 2px 6px 8px;
    border-bottom: 1px solid var(--wb-line);
  }

  .wb-brand__name {
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.15;
  }

  .wb-brand__sub {
    font-size: 0.7rem;
    color: var(--wb-muted);
  }

  .wb-nav-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .wb-nav-label {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--wb-muted);
    padding: 2px 8px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .wb-nav-item {
    position: relative;
    text-align: left;
    padding: 7px 10px 7px 13px;
    border-radius: 5px;
    border: 0;
    background: transparent;
    color: var(--wb-text);
    font-size: 0.84rem;
    cursor: pointer;
    transition: background 0.15s;
  }

  .wb-nav-item:hover {
    background: rgba(128, 128, 128, 0.12);
  }

  .wb-nav-item.is-active {
    background: var(--wb-brand-bg);
    color: var(--wb-brand);
    font-weight: 600;
  }

  .wb-nav-item.is-active::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 6px;
    bottom: 6px;
    width: 3px;
    border-radius: 3px;
    background: var(--wb-brand);
  }

  .wb-sidebar-foot {
    margin-top: auto;
    padding: 9px 10px;
    border-radius: 6px;
    background: var(--wb-elevated);
    border: 1px solid var(--wb-line);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.68rem;
    color: var(--wb-muted);
  }

  .wb-stream-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--wb-good);
    box-shadow: 0 0 8px var(--wb-good);
  }

  .wb-stream-dot[data-tone='deferred'] {
    background: var(--wb-warn);
    box-shadow: 0 0 8px var(--wb-warn);
  }

  @media (max-width: 920px) {
    .wb-sidebar {
      border-right: 0;
      border-bottom: 1px solid var(--wb-line);
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      padding: 10px 12px;
      gap: 6px;
    }
    .wb-brand,
    .wb-nav-label {
      display: none;
    }
    .wb-nav-group {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 4px;
    }
    .wb-sidebar-foot {
      margin-top: 0;
      margin-left: auto;
      padding: 4px 8px;
    }
  }

  .wb-workspace {
    padding: 16px 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  @media (max-width: 520px) {
    .wb-workspace {
      padding: 12px;
    }
  }

  .wb-topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--wb-line);
  }

  .wb-page-title {
    font-size: 1.32rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .wb-page-meta {
    font-size: 0.72rem;
    color: var(--wb-muted);
    margin-top: 3px;
  }

  .wb-commandbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .wb-select,
  .wb-input {
    height: 32px;
    padding: 0 10px;
    border-radius: 5px;
    border: 1px solid var(--wb-line);
    background: var(--wb-elevated);
    color: var(--wb-text);
    font-size: 0.78rem;
    max-width: 100%;
  }

  .wb-periods {
    display: inline-flex;
    flex-wrap: wrap;
    padding: 2px;
    border-radius: 6px;
    background: var(--wb-soft);
    border: 1px solid var(--wb-line);
    gap: 2px;
  }

  .wb-period {
    padding: 4px 10px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--wb-muted);
    font-size: 0.76rem;
    cursor: pointer;
  }

  .wb-period.is-active {
    background: var(--wb-elevated);
    color: var(--wb-brand);
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.16);
  }

  .wb-main {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  /* Hero Strip (4-col Fluent 2 Card) */
  .wb-hero-strip {
    display: grid;
    grid-template-columns: 1.45fr repeat(3, minmax(0, 1fr));
    border-radius: 6px;
    border: 1px solid var(--wb-line);
    background: var(--wb-elevated);
    overflow: hidden;
  }

  @media (max-width: 760px) {
    .wb-hero-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .wb-hero-cell {
    padding: 13px 15px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    border-right: 1px solid var(--wb-line);
  }
  .wb-hero-cell:last-child {
    border-right: 0;
  }

  .wb-cell-k {
    font-size: 0.72rem;
    color: var(--wb-muted);
  }

  .wb-hero-big {
    font-size: clamp(1.55rem, 2.4vw, 2.05rem);
    line-height: 1.1;
    color: var(--wb-brand);
  }

  .wb-hero-mid {
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .wb-cell-sub {
    font-size: 0.7rem;
    color: var(--wb-muted);
  }

  .wb-overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.58fr) minmax(240px, 0.95fr);
    gap: 12px;
  }

  @media (max-width: 980px) {
    .wb-overview-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .wb-overview-main,
  .wb-overview-side {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .wb-dual-panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media (max-width: 680px) {
    .wb-dual-panels {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .wb-panel {
    padding: 13px 14px;
    border-radius: 6px;
    border: 1px solid var(--wb-line);
    background: var(--wb-elevated);
    min-width: 0;
  }

  .wb-panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
  }

  .wb-panel-head h4 {
    font-size: 0.84rem;
    font-weight: 650;
  }

  .wb-panel-hint {
    font-size: 0.68rem;
    color: var(--wb-muted);
  }

  .wb-pills-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.68rem;
    color: var(--wb-muted);
  }

  .wb-pills-inline span {
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--wb-soft);
    border: 1px solid var(--wb-line);
  }

  .wb-spark-svg,
  .wb-trend-svg {
    width: 100%;
    height: auto;
  }

  .wb-stack {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .wb-row-btn,
  .wb-limit-mini,
  .wb-dev-mini,
  .wb-select-item {
    width: 100%;
    text-align: left;
    padding: 8px 9px;
    border-radius: 5px;
    border: 1px solid transparent;
    background: var(--wb-soft);
    color: inherit;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: border-color 0.15s;
  }

  .wb-select-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .wb-row-btn:hover,
  .wb-limit-mini:hover,
  .wb-dev-mini:hover,
  .wb-select-item:hover,
  .wb-select-item.is-active {
    border-color: var(--wb-brand);
  }

  .wb-row-top,
  .wb-row-sub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .wb-row-top {
    font-size: 0.8rem;
    font-weight: 560;
  }

  .wb-row-sub {
    font-size: 0.69rem;
    color: var(--wb-muted);
  }

  .wb-row-name {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
  }

  .wb-ico {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    object-fit: contain;
  }

  .wb-frame:not([data-wb-theme='light']) .wb-ico[data-ico-tone='mono-dark'] {
    filter: brightness(0) invert(1);
    opacity: 0.92;
  }

  .wb-frame:not([data-wb-theme='light']) .wb-ico[data-ico-key='qoder'] {
    filter: drop-shadow(0 0 0.6px rgba(255, 255, 255, 0.55));
  }

  .wb-swatch {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .wb-meter {
    height: 5px;
    border-radius: 999px;
    background: rgba(128, 128, 128, 0.18);
    overflow: hidden;
  }

  .wb-meter > span {
    display: block;
    height: 100%;
    border-radius: 999px;
  }

  .wb-fill--good { background: var(--wb-good); }
  .wb-fill--warn { background: var(--wb-warn); }
  .wb-fill--bad { background: var(--wb-bad); }

  .wb-tone--good { color: var(--wb-good); }
  .wb-tone--warn { color: var(--wb-warn); }
  .wb-tone--bad { color: var(--wb-bad); }

  .wb-credits-pill {
    font-style: normal;
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(251, 191, 36, 0.16);
    color: #fbbf24;
    font-size: 0.68rem;
  }

  .wb-dev-mini {
    flex-direction: row;
    align-items: center;
    gap: 9px;
  }

  .wb-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .wb-status-dot--live { background: #479ef5; box-shadow: 0 0 6px #479ef5; }
  .wb-status-dot--stale { background: #8c97a7; }

  .wb-dev-mini__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .wb-dev-mini__name {
    font-size: 0.79rem;
    font-weight: 600;
  }

  .wb-dev-mini__sub {
    font-size: 0.68rem;
    color: var(--wb-muted);
  }

  .wb-dev-mini__tok {
    font-size: 0.76rem;
  }

  .wb-wsl-tag {
    font-style: normal;
    font-size: 0.62rem;
    padding: 1px 5px;
    border-radius: 3px;
    background: rgba(56, 189, 248, 0.18);
    color: #38bdf8;
  }

  .wb-link-btn {
    border: 0;
    background: none;
    color: var(--wb-brand);
    font-size: 0.72rem;
    cursor: pointer;
