---
import { getImage } from 'astro:assets';
import wide from '../assets/renders/hero-wide.webp';
import tall from '../assets/renders/hero-tall.webp';
import { CONTENT, type Lang } from '../i18n/content';
import { REPO_URL, TOOLS } from '../data/product';
import type { ReleaseInfo } from '../data/release';
import DownloadLabel from './DownloadLabel.astro';

interface Props { lang: Lang; release: ReleaseInfo | null }
const { lang, release } = Astro.props;
const t = CONTENT[lang].hero;

const wideSet = await Promise.all([960, 1600, 2400].map((w) => getImage({ src: wide, width: w, format: 'webp', quality: 84 })));
const tallSet = await Promise.all([600, 900, 1200].map((w) => getImage({ src: tall, width: w, format: 'webp', quality: 84 })));
const srcset = (set: typeof wideSet) => set.map((i) => `${i.src} ${i.attributes.width}w`).join(', ');
const tools = TOOLS.map((x) => ({ n: x.name, c: [x.u, x.l, x.s] }));
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__stage" aria-hidden="true">
    <picture class="hero__poster">
      <source media="(max-aspect-ratio: 21/20)" srcset={srcset(tallSet)} sizes="100vw" />
      <img src={wideSet[1].src} srcset={srcset(wideSet)} sizes="100vw" alt="" width="2400" height="1260" fetchpriority="high" decoding="async" />
    </picture>
    <canvas class="hero__canvas" data-hero-canvas></canvas>
    <div class="hero__veil"></div>
  </div>

  <div class="wrap hero__content">
    <div class="hero__copy">
      <div class="hero__pills">
        <span class="hero__pulse-pill mono">
          <span class="hero__pulse-dot" aria-hidden="true"></span>
          <span>{t.eyebrow}</span>
        </span>
        <span class="hero__sub-pill mono">{t.badge}</span>
      </div>

      <h1 class="hero__title" id="hero-title">
        <span class="hero__brand">{t.name}</span>
        <span class="hero__motto">{t.motto}</span>
      </h1>

      <p class="hero__lead">{t.lead}</p>

      <div class="hero__ctas">
        <a class="btn btn--primary" href="#install" data-dl-primary>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 2v8.8m0 0L4.6 7.4M8 10.8l3.4-3.4M2.8 13.8h10.4" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{t.ctaPrimary}</span>
          <DownloadLabel release={release} />
        </a>
        <a class="btn btn--accent-ghost" href="#workbench">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <rect x="1.8" y="2.5" width="12.4" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.4" />
            <path d="M5.2 2.5v11M7.6 6.2h4.2M7.6 9.2h2.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
          <span>{t.ctaWorkbench}</span>
        </a>
      </div>

      <p class="hero__links mono">
        <a href="#install">{t.ctaAll}</a>
        <span aria-hidden="true">·</span>
        <a href={REPO_URL} rel="noopener">{t.ctaGithub} ↗</a>
      </p>
    </div>

    <dl class="hero__stats">
      {t.stats.map((s) => (
        <div class="hero__stat glass-card">
          <dt class="hero__stat-k">{s.k}</dt>
          <dd class="hero__stat-dd">
            <span class="hero__stat-n mono">{s.n}</span>
            <span class="hero__stat-sub">{s.sub}</span>
          </dd>
        </div>
      ))}
    </dl>

    <div class="hero__rail mono" aria-hidden="true">
      <span>{t.hudLeft}</span>
      <span>{t.hudRight}</span>
    </div>
  </div>

  <div class="hero__hud" aria-hidden="true">
    <div class="hero__counter" data-counter hidden>
      <span class="hero__counter-lead"></span>
      <span class="hero__counter-box">
        <span class="hero__counter-k mono">{lang === 'zh' ? '实时计量核心 · TOKENS' : 'LIVE METERED · TOKENS'}</span>
        <span class="hero__counter-n mono" data-counter-n>0</span>
      </span>
    </div>

    <div class="hero__tag hero__focus" data-focus hidden>
      <span class="hero__tag-dot"></span>
      <span class="hero__tag-line"></span>
      <span class="hero__tag-text mono">
        <span class="hero__focus-k" data-focus-k></span>
        <span data-focus-name></span>
        <span class="hero__focus-caps" data-focus-caps></span>
      </span>
    </div>

    <div class="hero__tag hero__credits" data-credits hidden>
      <span class="hero__tag-dot hero__tag-dot--amber"></span>
      <span class="hero__tag-line hero__tag-line--amber"></span>
      <span class="hero__tag-text mono">
        {lang === 'zh' ? 'CREDITS 独立通道 · 不混算 Token' : 'NATIVE CREDITS · ISOLATED CHANNEL'}
      </span>
    </div>
  </div>

  <script type="application/json" data-hero-tools set:html={JSON.stringify(tools)} />
</section>

<style>
  .hero {
    position: relative;
    min-height: max(720px, 100svh);
    display: flex;
    align-items: center;
    isolation: isolate;
    overflow: clip;
  }

  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg);
  }

  .hero__poster img,
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__poster img {
    object-fit: cover;
    object-position: 68% 48%;
  }

  .hero__canvas {
    opacity: 0;
    transition: opacity 0.95s var(--ease-out);
  }

  .hero.is-live .hero__canvas {
    opacity: 1;
  }

  /* 左侧与底部暗场渐变遮罩：确保文字对比度 >15:1，同时让右侧三维核心通透呈现 */
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(6 10 20 / 0.95) 0%, rgb(6 10 20 / 0.84) 36%, rgb(6 10 20 / 0.22) 66%, rgb(6 10 20 / 0.08) 100%),
      linear-gradient(180deg, rgb(6 10 20 / 0.88) 0%, rgb(6 10 20 / 0) 18%),
      linear-gradient(0deg, var(--bg) 0%, rgb(6 10 20 / 0.72) 14%, rgb(6 10 20 / 0) 34%);
    pointer-events: none;
  }

  @media (max-width: 960px) {
    .hero__veil {
      background:
        linear-gradient(180deg, rgb(6 10 20 / 0.88) 0%, rgb(6 10 20 / 0.72) 55%, var(--bg) 100%);
    }
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--nav-h) + clamp(36px, 6vh, 72px));
    padding-bottom: clamp(44px, 6vh, 76px);
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 5vh, 56px);
  }

  .hero__copy {
    max-width: 650px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .hero__pulse-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.69rem;
    letter-spacing: 0.1em;
    background: rgb(56 189 248 / 0.1);
    border: 1px solid rgb(56 189 248 / 0.3);
    color: #bae6fd;
  }

  @media (max-width: 560px) {
    .hero__pulse-pill {
      font-size: 0.58rem;
      letter-spacing: 0.055em;
      padding: 4px 10px;
      gap: 6px;
    }
  }

  .hero__pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--emerald);
    box-shadow: 0 0 10px var(--emerald);
    animation: heroPulse 2.4s ease-in-out infinite;
  }

  @keyframes heroPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.85); }
  }

  .hero__sub-pill {
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 0.69rem;
    letter-spacing: 0.04em;
    background: rgb(15 23 42 / 0.72);
    border: 1px solid var(--line);
    color: var(--fg-dim);
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hero__brand {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(3rem, 7vw, 5.4rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, #ffffff 15%, #bae6fd 65%, #38bdf8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  :lang(zh) .hero__brand {
    letter-spacing: 0.01em;
    line-height: 1.05;
  }

  .hero__motto {
    font-family: var(--f-display);
    font-weight: 650;
    font-size: clamp(1.38rem, 2.55vw, 2.15rem);
    line-height: 1.24;
    letter-spacing: -0.02em;
    color: var(--fg);
    text-wrap: balance;
  }

  :lang(zh) .hero__motto {
    line-height: 1.32;
    letter-spacing: 0;
  }

  .hero__lead {
    font-size: clamp(0.96rem, 1.15vw, 1.08rem);
    line-height: 1.7;
    color: var(--fg-dim);
    max-width: 56ch;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-top: 4px;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 0.78rem;
    color: var(--fg-dim);
  }

  .hero__links a {
    text-decoration: none;
    border-bottom: 1px solid var(--line-2);
    padding-bottom: 2px;
  }

  .hero__links a:hover {
    border-bottom-color: var(--cyan);
  }

  /* 底部四格事实计数器 */
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  @media (max-width: 960px) {
    .hero__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .hero__stats {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__ctas .btn {
      width: 100%;
    }
  }

  .hero__stat {
    padding: 16px 18px;
    border-radius: 12px;
    background: rgb(10 17 33 / 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 6px;
  }

  .hero__stat-k {
    font-size: 0.78rem;
    font-weight: 600;
    color: #cbd5e1;
    order: 2;
  }

  .hero__stat-dd {
    display: contents;
  }

  .hero__stat-n {
    order: 1;
    font-size: clamp(1.75rem, 2.8vw, 2.35rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--cyan);
  }

  .hero__stat-sub {
    order: 3;
    font-size: 0.74rem;
    line-height: 1.45;
    color: var(--fg-faint);
  }

  .hero__rail {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 20px;
    padding-top: 12px;
    border-top: 1px solid rgb(148 184 255 / 0.1);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
  }

  /* 空间三维投影 HUD 标注（仅桌面宽屏显示，绝不遮挡正文） */
  .hero__hud {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  @media (max-width: 1120px) {
    .hero__hud {
      display: none;
    }
  }

  .hero__counter {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    will-change: transform, opacity;
    transition: opacity 0.35s;
  }

  .hero__counter-lead {
    width: 32px;
    height: 1px;
    background: linear-gradient(90deg, var(--cyan), rgb(56 189 248 / 0.2));
  }

  .hero__counter-box {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 7px 12px;
    border-radius: 8px;
    background: rgb(7 13 27 / 0.82);
    border: 1px solid rgb(56 189 248 / 0.32);
    backdrop-filter: blur(8px);
  }

  .hero__counter-k {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--fg-dim);
  }

  .hero__counter-n {
    font-size: 1.05rem;
    font-weight: 650;
    color: #e0f2fe;
  }

  .hero__tag {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    will-change: transform, opacity;
    transition: opacity 0.25s;
  }

  .hero__tag.is-flipped {
    flex-direction: row-reverse;
  }

  .hero__tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
  }

  .hero__tag-dot--amber {
    background: var(--amber);
    box-shadow: 0 0 8px var(--amber);
  }

  .hero__tag-line {
    width: 24px;
    height: 1px;
    background: rgb(56 189 248 / 0.55);
  }

  .hero__tag-line--amber {
    background: rgb(251 191 36 / 0.6);
  }

  .hero__tag-text {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 9px;
    border-radius: 6px;
    font-size: 0.68rem;
    background: rgb(7 13 27 / 0.84);
    border: 1px solid rgb(148 184 255 / 0.22);
    color: #e2e8f0;
    white-space: nowrap;
  }

  .hero__focus-k {
    color: var(--cyan);
  }

  .hero__focus-caps {
    color: var(--emerald);
    letter-spacing: 0.08em;
    font-size: 0.62rem;
  }
</style>

<script>
  import type { HeroView, ScreenPoint } from '../scripts/hero/scene';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const stage = hero.querySelector<HTMLElement>('.hero__stage')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('[data-hero-canvas]')!;
  const counter = hero.querySelector<HTMLElement>('[data-counter]')!;
  const counterN = hero.querySelector<HTMLElement>('[data-counter-n]')!;
  const focus = hero.querySelector<HTMLElement>('[data-focus]')!;
  const focusK = hero.querySelector<HTMLElement>('[data-focus-k]')!;
  const focusName = hero.querySelector<HTMLElement>('[data-focus-name]')!;
  const focusCaps = hero.querySelector<HTMLElement>('[data-focus-caps]')!;
  const credits = hero.querySelector<HTMLElement>('[data-credits]')!;
  const toolsJson = hero.querySelector('[data-hero-tools]')?.textContent;
  const tools: { n: string; c: boolean[] }[] = toolsJson ? JSON.parse(toolsJson) : [];

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const gl = (() => {
    try {
      const c = document.createElement('canvas');
      return !!c.getContext('webgl2');
    } catch {
      return false;
    }
  })();

  const params = new URLSearchParams(location.search);
  const stillView = params.get('still') as HeroView | null;

  const pin = (el: HTMLElement, p: ScreenPoint) => {
    el.style.opacity = p.visible ? '1' : '0';
    if (!p.visible) return;
    const w = el.offsetWidth;
    const flip = p.x + w > stage.clientWidth - 20;
    el.classList.toggle('is-flipped', flip);
    el.style.transform = `translate3d(${(flip ? p.x - w : p.x).toFixed(1)}px, ${(p.y - el.offsetHeight * 0.5).toFixed(1)}px, 0)`;
  };

  if (stillView && gl) {
    document.fonts.ready
      .then(() => import('../scripts/hero/scene'))
      .then(({ startHero }) => {
        startHero({
          canvas,
          host: stage,
          tools: tools.map((x) => x.n),
          still: {
            view: stillView,
            time: Number(params.get('t') ?? 41.3),
            width: Number(params.get('w') ?? 2400),
            height: Number(params.get('h') ?? 1260),
          },
        });
        (window as Window & { __heroStill?: string }).__heroStill = canvas.toDataURL('image/png');
      });
  } else if (!reduced && gl) {
    const fmt = new Intl.NumberFormat('en-US');
    let lastText = '';
    const boot = () =>
      import('../scripts/hero/scene')
        .then(({ startHero }) => {
          startHero({
            canvas,
            host: stage,
            tools: tools.map((x) => x.n),
            onReady: () => {
              hero.classList.add('is-live');
              counter.hidden = false;
              focus.hidden = false;
              credits.hidden = false;
            },
            onCount: (n) => {
              const text = fmt.format(Math.floor(n));
              if (text !== lastText) counterN.textContent = lastText = text;
            },
            onReading: (p) => {
              const safeBand = p.y > 92 && p.y < stage.clientHeight - 265;
              const ok = p.visible && safeBand && stage.clientWidth >= 1120 && p.x > stage.clientWidth * 0.46;
              counter.style.opacity = ok ? '1' : '0';
              if (ok) {
                const maxX = Math.min(p.x, stage.clientWidth - counter.offsetWidth - 24);
                counter.style.transform = `translate3d(${maxX.toFixed(1)}px, ${(p.y - counter.offsetHeight / 2).toFixed(1)}px, 0)`;
              }
            },
            onCredits: (p) => {
              const safeBand = p.y > 92 && p.y < stage.clientHeight - 265;
              const ok = p.visible && safeBand && stage.clientWidth >= 1120 && p.x > stage.clientWidth * 0.48;
              pin(credits, { ...p, visible: ok });
            },
            onFocus: (p) => {
              const safeBand = p.y > 92 && p.y < stage.clientHeight - 265;
              const ok = p.visible && safeBand && stage.clientWidth >= 1120 && p.x > stage.clientWidth * 0.46;
              pin(focus, { ...p, visible: ok });
              if (!ok) return;
              const tool = tools[p.index];
              if (tool && focusName.textContent !== tool.n) {
                focusK.textContent = `#${String(p.index + 1).padStart(2, '0')}`;
                focusName.textContent = tool.n;
                focusCaps.textContent = tool.c.map((on) => (on ? '●' : '○')).join('');
              }
            },
          });
        })
        .catch((err) => console.warn('[hero] WebGL scene unavailable, keeping poster', err));

    const idle = () => {
      if ('requestIdleCallback' in window) window.requestIdleCallback(boot, { timeout: 1200 });
      else setTimeout(boot, 300);
    };
    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });
  }
</script>
