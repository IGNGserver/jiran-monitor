---
import { CONTENT, type Lang } from '../i18n/content';
import { REPO_URL } from '../data/product';
import type { ReleaseInfo } from '../data/release';
import DownloadLabel from './DownloadLabel.astro';
import ModelStage from './ModelStage.astro';

interface Props {
  lang: Lang;
  release: ReleaseInfo | null;
}
const { lang, release } = Astro.props;
const t = CONTENT[lang].hero;
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="wrap hero__content">
    <div class="hero__main">
      <div class="hero__copy">
        <div class="hero__kicker">
          <span class="eyebrow">{t.eyebrow}</span>
          <span class="hero__badge mono">{t.badge}</span>
        </div>

        <h1 class="hero__title" id="hero-title">
          <span class="hero__brand">{t.name}</span>
          <span class="hero__motto">{t.motto}</span>
        </h1>

        <p class="hero__lead">{t.lead}</p>

        <div class="hero__ctas">
          <a class="btn btn--primary" href="#install" data-dl-primary>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 2v8.8m0 0L4.6 7.4M8 10.8l3.4-3.4M2.8 13.8h10.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{t.ctaPrimary}</span>
            <DownloadLabel release={release} />
          </a>
          <a class="btn btn--ghost" href="#workbench">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <rect x="1.8" y="2.5" width="12.4" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.35" />
              <path d="M5.2 2.5v11M7.6 6.2h4.2M7.6 9.2h2.8" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
            </svg>
            <span>{t.ctaWorkbench}</span>
          </a>
        </div>

        <p class="hero__links mono">
          <a href="#features">{t.ctaFeatures}</a>
          <span aria-hidden="true">·</span>
          <a href="#install">{t.ctaAll}</a>
          <span aria-hidden="true">·</span>
          <a href={REPO_URL} rel="noopener">{t.ctaGithub} ↗</a>
        </p>
      </div>

      <div class="hero__visual">
        <ModelStage
          id="hero"
          aspect="hero"
          priority
          alt={t.stageAlt}
          caption={t.stageCaption}
        />

        <!-- 汇总账本示例条（Token 数量 / 花费 / 紧迫窗口 / 独立积分） -->
        <div class="hero__ledger" aria-label={t.readoutTitle}>
          <div class="hero__ledger-bar mono">
            <span class="hero__ledger-dot" aria-hidden="true"></span>
            <span>{t.readoutTitle}</span>
          </div>
          <div class="hero__ledger-grid">
            <div class="hero__ledger-cell">
              <span class="hero__ledger-k mono">{t.readoutTokLabel}</span>
              <strong class="hero__ledger-v hero__ledger-v--cyan mono" data-counter-n>0</strong>
            </div>
            <div class="hero__ledger-cell">
              <span class="hero__ledger-k mono">{t.readoutCostLabel}</span>
              <strong class="hero__ledger-v hero__ledger-v--brass mono" data-hero-cost>$47.82</strong>
            </div>
            <div class="hero__ledger-cell">
              <span class="hero__ledger-k mono">{t.readoutQuotaLabel}</span>
              <strong class="hero__ledger-v hero__ledger-v--cyan mono">38% · 1h42m</strong>
            </div>
            <div class="hero__ledger-cell">
              <span class="hero__ledger-k mono">{t.readoutCreditsLabel}</span>
              <strong class="hero__ledger-v hero__ledger-v--brass mono">120 Credits</strong>
            </div>
          </div>
          <div class="hero__mix-bar" aria-hidden="true">
            <span style="width: 21%" class="hero__mix-seg hero__mix-seg--in"></span>
            <span style="width: 9%" class="hero__mix-seg hero__mix-seg--out"></span>
            <span style="width: 58%" class="hero__mix-seg hero__mix-seg--cr"></span>
            <span style="width: 12%" class="hero__mix-seg hero__mix-seg--cw"></span>
          </div>
          <p class="hero__ledger-foot mono">{t.readoutMix}</p>
        </div>
      </div>
    </div>

    <!-- 底部核心产品数据矩阵（59 / 52 / 26 / 0） -->
    <dl class="hero__stats">
      {t.stats.map((s, idx) => (
        <div class="hero__stat">
          <dt class="hero__stat-k">{s.k}</dt>
          <dd class="hero__stat-dd">
            <span class:list={['hero__stat-n mono', idx === 2 && 'hero__stat-n--brass', idx === 3 && 'hero__stat-n--pure']}>
              {s.n}
            </span>
            <span class="hero__stat-sub">{s.sub}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 2;
    background:
      radial-gradient(60% 50% at 75% 28%, rgb(79 195 247 / 0.06) 0%, transparent 70%),
      var(--void);
  }

  .hero__content {
    padding-top: calc(var(--nav-h) + clamp(28px, 4.5vh, 56px));
    padding-bottom: clamp(44px, 6vh, 72px);
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4.5vh, 52px);
  }

  .hero__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  @media (max-width: 980px) {
    .hero__main {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hero__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .hero__badge {
    font-size: 0.7rem;
    padding: 3px 9px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-2);
    background: var(--ink-1);
    color: var(--fg-dim);
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero__brand {
    font-family: var(--f-display);
    font-weight: 640;
    font-size: clamp(2.8rem, 5.4vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--fg);
  }

  :lang(zh) .hero__brand {
    font-weight: 620;
    letter-spacing: 0.01em;
    line-height: 1.08;
  }

  .hero__motto {
    font-family: var(--f-display);
    font-weight: 540;
    font-size: clamp(1.26rem, 2.05vw, 1.76rem);
    line-height: 1.34;
    letter-spacing: -0.02em;
    color: var(--fg);
    text-wrap: balance;
  }

  :lang(zh) .hero__motto {
    font-weight: 520;
    letter-spacing: 0;
    line-height: 1.42;
  }

  .hero__lead {
    font-size: clamp(0.92rem, 1.04vw, 1rem);
    line-height: 1.74;
    color: var(--fg-dim);
    max-width: 56ch;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding-top: 4px;
  }

  @media (max-width: 480px) {
    .hero__ctas .btn {
      width: 100%;
    }
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 0.76rem;
    color: var(--fg-dim);
  }

  .hero__links a {
    text-decoration: none;
    border-bottom: 1px solid var(--line-2);
    padding-bottom: 1px;
  }

  .hero__links a:hover {
    color: var(--fg);
    border-bottom-color: var(--cyan);
  }

  .hero__visual {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  /* 汇总读数示例条 */
  .hero__ledger {
    border-radius: var(--radius-md);
    border: 1px solid var(--line-2);
    background: var(--ink-1);
    overflow: hidden;
  }

  .hero__ledger-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px;
    border-bottom: 1px solid var(--line);
    font-size: 0.68rem;
    color: var(--fg-dim);
  }

  .hero__ledger-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px rgb(79 195 247 / 0.65);
  }

  .hero__ledger-grid {
    display: grid;
    grid-template-columns: 1.32fr 1fr 1fr 1fr;
    background: var(--line);
    gap: 1px;
  }

  @media (max-width: 680px) {
    .hero__ledger-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .hero__ledger-cell {
    background: var(--ink-1);
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .hero__ledger-k {
    font-size: 0.65rem;
    color: var(--fg-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero__ledger-v {
    font-size: 0.94rem;
    font-weight: 580;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .hero__ledger-v--cyan {
    color: var(--cyan);
  }

  .hero__ledger-v--brass {
    color: var(--brass);
  }

  .hero__mix-bar {
    display: flex;
    height: 3px;
    background: var(--ink-2);
    border-top: 1px solid var(--line);
  }

  .hero__mix-seg--in { background: #4fc3f7; }
  .hero__mix-seg--out { background: #eef1f6; }
  .hero__mix-seg--cr { background: rgb(79 195 247 / 0.42); }
  .hero__mix-seg--cw { background: #e5a94c; }

  .hero__ledger-foot {
    padding: 6px 13px;
    font-size: 0.68rem;
    color: var(--fg-dim);
    border-top: 1px solid var(--line);
  }

  /* 底部四格产品数据卡片 */
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  @media (max-width: 960px) {
    .hero__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .hero__stats {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .hero__stat {
    padding: 16px 18px;
    border-radius: var(--radius-md);
    border: 1px solid var(--line-2);
    background: var(--ink-1);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .hero__stat-dd {
    display: contents;
  }

  .hero__stat-n {
    order: 1;
    font-size: clamp(1.8rem, 2.6vw, 2.35rem);
    font-weight: 580;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--cyan);
  }

  .hero__stat-n--brass {
    color: var(--brass);
  }

  .hero__stat-n--pure {
    color: var(--fg);
  }

  .hero__stat-k {
    order: 2;
    font-size: 0.86rem;
    font-weight: 580;
    color: var(--fg);
  }

  .hero__stat-sub {
    order: 3;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--fg-dim);
  }
</style>

<script>
  const counterEl = document.querySelector<HTMLElement>('[data-counter-n]');
  const costEl = document.querySelector<HTMLElement>('[data-hero-cost]');

  if (counterEl) {
    const fmt = new Intl.NumberFormat('en-US');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const baseTokens = 184_920_410;
    const baseCost = 47.82;

    if (reduced) {
      counterEl.textContent = fmt.format(baseTokens);
    } else {
      const t0 = performance.now();
      let bonus = 0;

      const ramp = (now: number) => {
        const p = Math.min(1, (now - t0) / 900);
        const eased = 1 - Math.pow(1 - p, 3);
        counterEl.textContent = fmt.format(Math.floor(baseTokens * eased));
        if (p < 1) {
          requestAnimationFrame(ramp);
        }
      };
      requestAnimationFrame(ramp);

      window.setInterval(() => {
        if (document.hidden) return;
        const delta = 1420 + Math.floor(Math.random() * 2890);
        bonus += delta;
        counterEl.textContent = fmt.format(baseTokens + bonus);
        if (costEl) {
          const usd = baseCost + bonus * 0.0000042;
          costEl.textContent = `$${usd.toFixed(2)}`;
        }
      }, 2200);
    }
  }
</script>
