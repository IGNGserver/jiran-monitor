---
import { getImage } from 'astro:assets';
import wide from '../assets/renders/kelou-wide.webp';
import tall from '../assets/renders/kelou-tall.webp';
import { CONTENT, type Lang } from '../i18n/content';
import { REPO_URL, TOOLS } from '../data/product';
import type { ReleaseInfo } from '../data/release';
import DownloadLabel from './DownloadLabel.astro';

interface Props { lang: Lang; release: ReleaseInfo | null }
const { lang, release } = Astro.props;
const t = CONTENT[lang].hero;

const wideSet = await Promise.all([960, 1600, 2400].map((w) => getImage({ src: wide, width: w, format: 'webp', quality: 82 })));
const tallSet = await Promise.all([600, 900, 1200].map((w) => getImage({ src: tall, width: w, format: 'webp', quality: 82 })));
const srcset = (set: typeof wideSet) => set.map((i) => `${i.src} ${i.attributes.width}w`).join(', ');
const tools = TOOLS.map((x) => ({ n: x.name, c: [x.u, x.l, x.s] }));
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__stage" aria-hidden="true">
    <picture class="hero__poster">
      <source media="(max-aspect-ratio: 21/20)" srcset={srcset(tallSet)} sizes="100vw" />
      <img src={wideSet[1].src} srcset={srcset(wideSet)} sizes="100vw" alt="" width="2400" height="1260" fetchpriority="high" decoding="async" />
    </picture>
    <canvas class="hero__canvas" data-hero-canvas></canvas>
    <div class="hero__veil"></div>
  </div>

  <div class="wrap hero__content">
    <p class="hero__eyebrow mono">{t.eyebrow}</p>
    <div class="hero__heading">
      <h1 class="hero__title" id="hero-title">{t.title}</h1>
      <p class="hero__motto">
        <span class="hero__motto-text">{t.motto}</span>
        <span class="hero__seal" lang="zh-CN" aria-hidden="true">计然</span>
      </p>
    </div>
    <p class="hero__lead">{t.lead}</p>
    <div class="hero__ctas">
      <a class="btn btn--primary" href="#install" data-dl-primary>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v9m0 0L4.5 7.5M8 11l3.5-3.5M3 14h10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span>{t.ctaPrimary}</span>
        <DownloadLabel release={release} />
      </a>
      <a class="btn" href="#install">{t.ctaAll}</a>
      <a class="btn hero__src" href={REPO_URL} rel="noopener">{t.ctaSource} ↗</a>
    </div>
    <dl class="hero__stats">
      {t.stats.map((s) => (
        <div>
          <dt class="sr-only">{s.k}</dt>
          <dd><span class="hero__stat-n mono">{s.n}</span><span class="hero__stat-k">{s.k}</span></dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="hero__hud" aria-hidden="true">
    <div class="hero__counter" data-counter hidden>
      <span class="hero__counter-lead"></span>
      <span class="hero__counter-body">
        <span class="note">{t.counterLabel}</span>
        <span class="hero__counter-n mono" data-counter-n>~0</span>
        <span class="note">{t.counterUnit} · {t.counterNote}</span>
      </span>
    </div>
    <div class="hero__tag hero__focus" data-focus hidden>
      <span class="hero__tag-dot"></span>
      <span class="hero__tag-line"></span>
      <span class="hero__tag-text mono"><span class="hero__focus-k" data-focus-k></span><span data-focus-name></span><span class="hero__focus-caps" data-focus-caps></span></span>
    </div>
    <div class="hero__tag hero__credits" data-credits hidden>
      <span class="hero__tag-dot"></span>
      <span class="hero__tag-line"></span>
      <span class="hero__tag-text mono">{t.creditsLabel}</span>
    </div>
  </div>

  <a class="hero__cue mono" href="#name">{t.scroll}<span></span></a>
  <script type="application/json" data-hero-tools set:html={JSON.stringify(tools)} />
</section>

<style>
  .hero {
    position: relative;
    min-height: max(640px, 100svh);
    display: flex;
    align-items: center;
    isolation: isolate;
  }
  .hero__stage {
    position: fixed;
    inset: 0;
    z-index: -1;
    height: 100lvh;
    background: var(--bg);
  }
  .hero__poster img,
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__poster img {
    object-fit: cover;
    object-position: 70% 50%;
  }
  .hero__canvas {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .hero.is-live .hero__canvas {
    opacity: 1;
  }
  /* 左侧铺一层纸色，给文字留白；底部融进正文 */
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(242 237 227 / 0.94) 0%, rgb(242 237 227 / 0.7) 30%, rgb(242 237 227 / 0) 54%),
      linear-gradient(180deg, rgb(242 237 227 / 0.92) 0%, rgb(242 237 227 / 0) 16%),
      linear-gradient(0deg, var(--bg) 0%, rgb(242 237 227 / 0) 20%);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    padding-top: calc(var(--nav-h) + 40px);
    padding-bottom: 120px;
  }
  .hero__eyebrow {
    font-size: var(--t-micro);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-bottom: 18px;
  }
  .hero__heading {
    display: flex;
    align-items: flex-start;
    gap: clamp(14px, 2vw, 28px);
  }
  .hero__title {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--t-hero);
    line-height: 0.86;
    letter-spacing: -0.03em;
    margin-left: -0.04em;
  }
  :lang(zh) .hero__title {
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
  }
  /* 题跋：竖排的「点滴有数」，末尾压一方朱印 */
  .hero__motto {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding-top: 0.6em;
  }
  .hero__motto-text {
    writing-mode: vertical-rl;
    font-family: 'Noto Serif SC', 'Songti SC', serif;
    font-size: clamp(1.05rem, 1.7vw, 1.45rem);
    letter-spacing: 0.42em;
    color: var(--fg-dim);
  }
  .hero__seal {
    display: block;
    padding: 0.32em 0.26em;
    font-family: 'Noto Serif SC', 'Songti SC', serif;
    font-weight: 600;
    font-size: clamp(0.72rem, 1vw, 0.86rem);
    line-height: 1;
    writing-mode: vertical-rl;
    letter-spacing: 0.08em;
    color: var(--bg);
    background: var(--cinnabar);
    border-radius: 3px;
    box-shadow: inset 0 0 0 2px var(--cinnabar), inset 0 0 0 3px rgb(242 237 227 / 0.55);
  }
  :lang(en) .hero__heading {
    flex-direction: column;
    gap: 18px;
  }
  :lang(en) .hero__motto {
    flex-direction: row;
    padding-top: 0;
  }
  :lang(en) .hero__motto-text {
    writing-mode: horizontal-tb;
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    letter-spacing: 0;
    color: var(--fg-dim);
  }
  .hero__lead {
    margin-top: clamp(22px, 3vw, 34px);
    max-width: 30em;
    font-size: var(--t-lead);
    line-height: 1.62;
    color: var(--fg);
    text-wrap: pretty;
  }
  :lang(zh) .hero__lead {
    max-width: 30em;
  }
  @media (min-width: 700px) {
    :lang(zh) .hero__lead {
      word-break: keep-all;
    }
  }
  :lang(en) .hero__lead {
    max-width: 28em;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 36px;
    margin: 56px 0 0;
  }
  .hero__stats dd {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .hero__stat-n {
    font-size: 1.5rem;
    color: var(--fg);
  }
  .hero__stats div:last-child .hero__stat-n {
    color: var(--cinnabar);
  }
  .hero__stat-k {
    font-size: var(--t-small);
    color: var(--fg-dim);
  }

  .hero__hud {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  /* 读数：实时场景里贴在朱砂指针右侧；没有锚点时退回右下角 */
  .hero__counter {
    position: absolute;
    right: var(--gutter);
    top: calc(var(--nav-h) + 24px);
    display: flex;
    align-items: center;
    gap: 0;
  }
  .hero__counter.is-anchored {
    right: auto;
    bottom: auto;
    left: 0;
    top: 0;
    will-change: transform;
  }
  .hero__counter-lead {
    display: none;
    width: 44px;
    height: 1px;
    background: var(--cinnabar);
  }
  .hero__counter.is-anchored .hero__counter-lead {
    display: block;
  }
  .hero__counter-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-left: 12px;
    max-width: 15em;
    text-shadow: 0 0 10px var(--bg), 0 0 3px var(--bg);
  }
  .hero__counter:not(.is-anchored) .hero__counter-body {
    align-items: flex-end;
    text-align: right;
  }
  .hero__counter-n {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .hero__tag {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    will-change: transform;
    transition: opacity 0.4s;
  }
  .hero__tag-dot {
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    border: 1px solid var(--fg);
    border-radius: 50%;
  }
  .hero__tag-line {
    width: 36px;
    height: 1px;
    background: var(--line-2);
  }
  .hero__tag-text {
    display: inline-flex;
    gap: 8px;
    align-items: baseline;
    padding: 4px 9px;
    font-size: 0.75rem;
    color: var(--fg);
    background: rgb(242 237 227 / 0.82);
    border: 1px solid var(--line);
    white-space: nowrap;
  }
  .hero__focus-k {
    color: var(--fg-faint);
  }
  .hero__focus-caps {
    color: var(--celadon);
    letter-spacing: 0.1em;
  }
  .hero__credits .hero__tag-dot {
    border-color: var(--rule);
  }
  /* 靠近右缘时标签翻到左侧 */
  .hero__tag.is-flipped {
    flex-direction: row-reverse;
  }
  .hero__tag.is-flipped .hero__tag-dot {
    margin: 0 -4.5px 0 0;
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: 28px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-size: var(--t-micro);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-faint);
    text-decoration: none;
  }
  .hero__cue span {
    width: 1px;
    height: 36px;
    background: linear-gradient(var(--fg-faint), transparent);
    animation: cue 2.4s var(--ease-io) infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0% { transform: scaleY(0); }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  @media (max-aspect-ratio: 21/20) {
    .hero {
      align-items: flex-end;
    }
    .hero__poster img {
      object-position: 50% 30%;
    }
    .hero__veil {
      background:
        linear-gradient(0deg, rgb(242 237 227 / 0.97) 0%, rgb(242 237 227 / 0.8) 40%, rgb(242 237 227 / 0) 62%),
        linear-gradient(180deg, rgb(242 237 227 / 0.6) 0%, rgb(242 237 227 / 0) 14%);
    }
    .hero__content {
      padding-top: max(calc(var(--nav-h) + 40px), 50svh);
      padding-bottom: 48px;
    }
    .hero__counter:not(.is-anchored) {
      top: calc(var(--nav-h) + 12px);
    }
    .hero__cue {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .hero__counter,
    .hero__credits {
      display: none;
    }
    .hero__src {
      display: none;
    }
    .hero__stats {
      gap: 8px 22px;
      margin-top: 40px;
    }
    .hero__stat-n {
      font-size: 1.2rem;
    }
  }
</style>

<script>
  import type { HeroView, ScreenPoint } from '../scripts/hero/scene';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('[data-hero-canvas]')!;
  const stage = hero.querySelector<HTMLElement>('.hero__stage')!;
  const counter = hero.querySelector<HTMLElement>('[data-counter]')!;
  const counterN = hero.querySelector<HTMLElement>('[data-counter-n]')!;
  const focus = hero.querySelector<HTMLElement>('[data-focus]')!;
  const focusK = hero.querySelector<HTMLElement>('[data-focus-k]')!;
  const focusName = hero.querySelector<HTMLElement>('[data-focus-name]')!;
  const focusCaps = hero.querySelector<HTMLElement>('[data-focus-caps]')!;
  const credits = hero.querySelector<HTMLElement>('[data-credits]')!;
  const tools: { n: string; c: boolean[] }[] = JSON.parse(hero.querySelector('[data-hero-tools]')!.textContent || '[]');

  // 首屏之后整个舞台淡出，内容区盖在上面
  const fade = () => {
    const p = Math.min(1, Math.max(0, window.scrollY / (hero.offsetHeight * 0.9)));
    stage.style.opacity = String(1 - Math.max(0, (p - 0.45) / 0.55));
    stage.style.visibility = p >= 1 ? 'hidden' : 'visible';
  };
  window.addEventListener('scroll', fade, { passive: true });
  fade();

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const gl = (() => {
    try {
      const c = document.createElement('canvas');
      return !!c.getContext('webgl2');
    } catch {
      return false;
    }
  })();

  const params = new URLSearchParams(location.search);
  const stillView = params.get('still') as HeroView | null;

  /** 把 HUD 元素移到画布坐标上；看不见时淡出 */
  const pin = (el: HTMLElement, p: ScreenPoint) => {
    el.style.opacity = p.visible ? '1' : '0';
    if (!p.visible) return;
    const w = el.offsetWidth;
    const flip = p.x + w > stage.clientWidth - 16;
    el.classList.toggle('is-flipped', flip);
    el.style.transform = `translate3d(${(flip ? p.x - w : p.x).toFixed(1)}px, ${p.y.toFixed(1)}px, 0)`;
  };

  if (stillView && gl) {
    // 静帧模式（design/tools/stills.mjs）：等字体就绪，渲染指定时刻的一帧，交出 PNG
    document.fonts.ready
      .then(() => import('../scripts/hero/scene'))
      .then(({ startHero }) => {
        startHero({
          canvas,
          host: stage,
          tools: tools.map((x) => x.n),
          still: {
            view: stillView,
            time: Number(params.get('t') ?? 42),
            width: Number(params.get('w') ?? 2400),
            height: Number(params.get('h') ?? 1260),
          },
        });
        (window as Window & { __heroStill?: string }).__heroStill = canvas.toDataURL('image/png');
      });
  } else if (!reduced && gl) {
    const fmt = new Intl.NumberFormat('en-US');
    let lastText = '';
    const boot = () =>
      import('../scripts/hero/scene')
        .then(({ startHero }) => {
          startHero({
            canvas,
            host: stage,
            tools: tools.map((x) => x.n),
            onReady: () => {
              hero.classList.add('is-live');
              counter.hidden = false;
              focus.hidden = false;
              credits.hidden = false;
            },
            onCount: (n) => {
              const text = '~' + fmt.format(Math.floor(n));
              if (text !== lastText) counterN.textContent = lastText = text;
            },
            onReading: (p) => {
              // 宽屏把读数贴在指针旁；竖屏指针附近没有空间，读数留在角落
              // 角落状态下没有引线，宽度要补上引线的 44px，避免在两种状态间来回跳
              const width = counter.offsetWidth + (counter.classList.contains('is-anchored') ? 0 : 44);
              const anchor = p.visible && stage.clientWidth / stage.clientHeight >= 1.05 && p.x + width < stage.clientWidth - 16;
              counter.classList.toggle('is-anchored', anchor);
              if (anchor) counter.style.transform = `translate3d(${p.x.toFixed(1)}px, ${(p.y - counter.offsetHeight / 2).toFixed(1)}px, 0)`;
              else counter.style.transform = '';
            },
            onCredits: (p) => pin(credits, p),
            onFocus: (p) => {
              pin(focus, p);
              if (!p.visible) return;
              const tool = tools[p.index];
              if (tool && focusName.textContent !== tool.n) {
                focusK.textContent = String(p.index + 1).padStart(2, '0');
                focusName.textContent = tool.n;
                focusCaps.textContent = tool.c.map((on) => (on ? '●' : '○')).join('');
              }
            },
          });
        })
        .catch((err) => console.warn('[hero] WebGL scene unavailable, keeping the still', err));
    // 让首帧文字、静帧与字体先加载完（load 之后、空闲时）再加载 three（约 140KB gzip），避免与首屏资源抢带宽。
    // 与 scripts/release.ts 的同名逻辑各写一份：抽成共享模块会多出一个串行请求，拖慢本脚本执行
    const idle = () => {
      if ('requestIdleCallback' in window) (window as Window).requestIdleCallback(boot, { timeout: 1200 });
      else setTimeout(boot, 300);
    };
    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });
  }
</script>
