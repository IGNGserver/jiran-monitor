---
import type { ReleaseInfo } from '../data/release';
interface Props { release: ReleaseInfo | null }
const { release } = Astro.props;
---
<span class="dl-meta mono" data-dl-meta>{release?.tag ?? 'v1.x'}</span>

<style>
  .dl-meta {
    padding: 2px 7px;
    border-radius: 2px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    background: rgb(5 6 8 / 0.14);
    border: 1px solid rgb(5 6 8 / 0.22);
    color: inherit;
  }
</style>
