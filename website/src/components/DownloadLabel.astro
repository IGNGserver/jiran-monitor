---
import type { ReleaseInfo } from '../data/release';
interface Props { release: ReleaseInfo | null }
const { release } = Astro.props;
---
<span class="dl-meta mono" data-dl-meta>{release?.tag ?? 'v1.x'}</span>

<style>
  .dl-meta {
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    background: rgb(3 7 18 / 0.16);
    color: inherit;
  }
</style>
