---
import SectionHead from './SectionHead.astro';
import { CONTENT, type Lang } from '../i18n/content';
import { DOCS, HUB_SNIPPET, RELEASES_URL } from '../data/product';
import type { ReleaseInfo } from '../data/release';

interface Props { lang: Lang; release: ReleaseInfo | null }
const { lang, release } = Astro.props;
const t = CONTENT[lang].install;

const platformOrder = ['mac', 'win', 'linux', 'android', 'server'] as const;
const fmtSize = (bytes?: number) =>
  bytes ? `${(bytes / 1048576).toFixed(bytes > 1048576 * 10 ? 0 : 1)} MB` : '';
---

<section class="section" id="install" aria-labelledby="inst-title">
  <div class="wrap">
    <SectionHead id="inst-title" index={t.index} title={t.title} lead={t.lead} />

    <div class="inst-meta mono reveal">
      <span>
        {t.currentRelease}:{' '}
        <a href={release?.url ?? RELEASES_URL} data-release-url rel="noopener">
          <strong data-release-tag>{release?.tag ?? 'latest'}</strong>
        </a>
        {release?.publishedAt && (
          <>
            {' · '}
            <time datetime={release.publishedAt} data-release-date>{release.publishedAt.slice(0, 10)}</time>
          </>
        )}
      </span>
      <span class="inst-meta__links">
        <a href={RELEASES_URL} rel="noopener">{t.allReleases} ↗</a>
        <span>·</span>
        <a href={DOCS.signing} rel="noopener">{t.signingLink}</a>
        <span>·</span>
        <a href={DOCS.updates} rel="noopener">{t.updatesLink}</a>
      </span>
    </div>

    <div class="inst-grid reveal">
      <!-- 左栏：五平台安装包标签页 -->
      <div class="inst-downloads glass-card" data-dl>
        <div class="inst-tabs" role="tablist" aria-label={lang === 'zh' ? '选择操作系统' : 'Choose platform'}>
          {platformOrder.map((key, idx) => (
            <button
              type="button"
              role="tab"
              id={`tab-${key}`}
              class="inst-tab mono"
              data-platform={key}
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls={`panel-${key}`}
              tabindex={idx === 0 ? 0 : -1}
            >
              {t.platforms[key].label}
            </button>
          ))}
        </div>

        {platformOrder.map((key, idx) => {
          const p = t.platforms[key];
          return (
            <div
              role="tabpanel"
              id={`panel-${key}`}
              aria-labelledby={`tab-${key}`}
              class="inst-panel"
              data-panel={key}
              hidden={idx !== 0}
            >
              <p class="inst-panel__badge mono">{p.badge}</p>
              <div class="inst-assets">
                {p.items.map((item) => {
                  const asset = release?.assets[item.asset];
                  return (
                    <a
                      class="inst-asset"
                      href={asset?.url ?? RELEASES_URL}
                      data-asset={item.asset}
                      aria-disabled={asset ? undefined : 'true'}
                      rel="noopener"
                    >
                      <div class="inst-asset__info">
                        <strong class="inst-asset__title">{item.title}</strong>
                        <span class="inst-asset__sub">{item.sub}</span>
                        <span class="inst-asset__file mono" data-asset-name>{asset?.name ?? 'GitHub Releases'}</span>
                      </div>
                      <div class="inst-asset__right mono">
                        <span class="inst-asset__size" data-asset-size>{fmtSize(asset?.size)}</span>
                        <span class="inst-asset__dl" aria-hidden="true">↓</span>
                      </div>
                    </a>
                  );
                })}
              </div>
              <p class="inst-panel__note">{p.note}</p>
            </div>
          );
        })}
      </div>

      <!-- 右栏：自建 Docker Compose Hub 快速启动 -->
      <div class="inst-hub glass-card">
        <div class="inst-hub__head">
          <h3 class="inst-hub__title">{t.hubBoxTitle}</h3>
          <button
            type="button"
            class="inst-copy mono"
            data-copy-btn
            data-label-copy={t.copyBtn}
            data-label-copied={t.copiedBtn}
          >
            {t.copyBtn}
          </button>
        </div>
        <pre class="inst-code mono"><code data-copy-src>{HUB_SNIPPET}</code></pre>
        <ul class="inst-hub__specs mono" aria-label={lang === 'zh' ? 'Hub 规格参数' : 'Hub specifications'}>
          <li><span>BIND</span><strong>127.0.0.1:17321</strong></li>
          <li><span>STORE</span><strong>MySQL 8.4</strong></li>
          <li><span>VAULT</span><strong>AES-256-GCM</strong></li>
          <li><span>STREAM</span><strong>Slim SSE · PWA</strong></li>
        </ul>
        <p class="inst-hub__doc mono">
          <a href={DOCS.hub} rel="noopener">{t.hubDocLink}</a>
        </p>
      </div>
    </div>

    <p class="inst-verified reveal">{t.verified}</p>
  </div>
</section>

<style>
  .inst-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
    padding: 12px 18px;
    border-radius: 10px;
    background: rgb(11 18 34 / 0.68);
    border: 1px solid var(--line);
    font-size: 0.76rem;
    color: var(--fg-dim);
    margin-bottom: 18px;
  }

  .inst-meta strong {
    color: var(--cyan);
  }

  .inst-meta__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .inst-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 18px;
    align-items: stretch;
  }

  @media (max-width: 980px) {
    .inst-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .inst-downloads,
  .inst-hub {
    padding: clamp(20px, 2.5vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .inst-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .inst-tab {
    padding: 7px 14px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: rgb(6 10 20 / 0.65);
    color: var(--fg-dim);
    font-size: 0.78rem;
    cursor: pointer;
    transition: border-color 0.18s, color 0.18s, background 0.18s;
  }

  .inst-tab:hover {
    color: var(--fg);
    border-color: var(--line-2);
  }

  .inst-tab[aria-selected='true'] {
    border-color: var(--cyan);
    background: rgb(56 189 248 / 0.15);
    color: #e0f2fe;
    font-weight: 650;
  }

  .inst-panel {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .inst-panel__badge {
    font-size: 0.71rem;
    letter-spacing: 0.06em;
    color: var(--emerald);
  }

  .inst-assets {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .inst-asset {
    padding: 14px 16px;
    border-radius: 10px;
    border: 1px solid var(--line-2);
    background: rgb(6 10 20 / 0.72);
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    transition: border-color 0.2s, background 0.2s, transform 0.2s var(--ease-out);
  }

  .inst-asset:hover {
    color: var(--fg);
    border-color: var(--cyan);
    background: rgb(14 25 48 / 0.9);
    transform: translateY(-1px);
  }

  .inst-asset__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .inst-asset__title {
    font-size: 0.94rem;
    color: var(--fg);
  }

  .inst-asset__sub {
    font-size: 0.8rem;
    color: var(--fg-dim);
  }

  .inst-asset__file {
    font-size: 0.71rem;
    color: var(--cyan);
    overflow-wrap: anywhere;
  }

  .inst-asset__right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    font-size: 0.75rem;
    color: var(--fg-dim);
  }

  .inst-asset__dl {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgb(56 189 248 / 0.14);
    color: var(--cyan);
    font-weight: 700;
  }

  .inst-panel__note {
    margin-top: auto;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--fg-faint);
  }

  .inst-hub__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .inst-hub__title {
    font-size: 1.05rem;
    font-weight: 660;
  }

  .inst-copy {
    padding: 5px 11px;
    border-radius: 6px;
    border: 1px solid var(--line-2);
    background: rgb(6 10 20 / 0.78);
    color: #e2e8f0;
    font-size: 0.72rem;
    cursor: pointer;
  }

  .inst-copy:hover {
    border-color: var(--cyan);
    color: #ffffff;
  }

  .inst-code {
    margin: 0;
    padding: 16px;
    border-radius: 10px;
    background: #04070f;
    border: 1px solid var(--line);
    font-size: 0.78rem;
    line-height: 1.72;
    color: #bae6fd;
    overflow-x: auto;
  }

  .inst-hub__specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-top: auto;
  }

  .inst-hub__specs li {
    padding: 9px 12px;
    border-radius: 8px;
    background: rgb(6 10 20 / 0.68);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .inst-hub__specs span {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
  }

  .inst-hub__specs strong {
    font-size: 0.76rem;
    font-weight: 600;
    color: #e2e8f0;
  }

  .inst-hub__doc {
    font-size: 0.76rem;
  }

  .inst-hub__doc a {
    color: var(--cyan);
  }

  .inst-verified {
    margin-top: 18px;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--fg-faint);
  }
</style>

<script>
  const dlBox = document.querySelector<HTMLElement>('[data-dl]');
  if (dlBox) {
    const tabs = [...dlBox.querySelectorAll<HTMLButtonElement>('[data-platform]')];
    const panels = [...dlBox.querySelectorAll<HTMLElement>('[data-panel]')];

    const activate = (platform: string, moveFocus = false) => {
      const targetTab = tabs.find((t) => t.dataset.platform === platform);
      if (!targetTab) return;
      for (const tab of tabs) {
        const on = tab === targetTab;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && moveFocus) tab.focus();
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.panel !== platform;
      }
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => activate(tab.dataset.platform!));
      tab.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next >= 0) {
          e.preventDefault();
          activate(tabs[next].dataset.platform!, true);
        }
      });
    });

    document.addEventListener('jiran:platform', (e) => {
      const p = (e as CustomEvent<string>).detail;
      if (p) activate(p);
    });
  }

  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-btn]');
  const copySrc = document.querySelector<HTMLElement>('[data-copy-src]');
  if (copyBtn && copySrc) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copySrc.textContent ?? '');
        copyBtn.textContent = copyBtn.dataset.labelCopied ?? 'Copied';
        setTimeout(() => {
          copyBtn.textContent = copyBtn.dataset.labelCopy ?? 'Copy';
        }, 1800);
      } catch {
        /* ignore clipboard restrictions */
      }
    });
  }
</script>
