---
import { CONTENT, type Lang } from '../i18n/content';
import { DOCS, HUB_SNIPPET, RELEASES_URL } from '../data/product';
import type { ReleaseInfo } from '../data/release';

interface Props {
  lang: Lang;
  release: ReleaseInfo | null;
}
const { lang, release } = Astro.props;
const t = CONTENT[lang].install;

const platformOrder = ['mac', 'win', 'linux', 'android', 'server'] as const;
const fmtSize = (bytes?: number) =>
  bytes ? `${(bytes / 1048576).toFixed(bytes > 1048576 * 10 ? 0 : 1)} MB` : '';
---

<section class="section" id="install" aria-labelledby="inst-title">
  <div class="wrap">
    <header class="sec-head reveal">
      <div class="sec-head__left">
        <span class="eyebrow">{t.index}</span>
        <h2 class="sec-title" id="inst-title">{t.title}</h2>
      </div>
      <p class="sec-lead">{t.lead}</p>
    </header>

    <div class="inst-meta mono reveal">
      <span>
        {t.currentRelease}:{' '}
        <a href={release?.url ?? RELEASES_URL} data-release-url rel="noopener">
          <strong data-release-tag>{release?.tag ?? 'latest'}</strong>
        </a>
        {release?.publishedAt && (
          <>
            {' · '}
            <time datetime={release.publishedAt} data-release-date>{release.publishedAt.slice(0, 10)}</time>
          </>
        )}
      </span>
      <span class="inst-meta__links">
        <a href={RELEASES_URL} rel="noopener">{t.allReleases} ↗</a>
        <span>·</span>
        <a href={DOCS.signing} rel="noopener">{t.signingLink}</a>
        <span>·</span>
        <a href={DOCS.updates} rel="noopener">{t.updatesLink}</a>
      </span>
    </div>

    <div class="inst-grid reveal">
      <!-- 左栏：五平台安装包标签页 -->
      <div class="inst-downloads" data-dl>
        <div class="inst-tabs" role="tablist" aria-label={lang === 'zh' ? '选择操作系统' : 'Choose platform'}>
          {platformOrder.map((key, idx) => (
            <button
              type="button"
              role="tab"
              id={`tab-${key}`}
              class="inst-tab mono"
              data-platform={key}
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls={`panel-${key}`}
              tabindex={idx === 0 ? 0 : -1}
            >
              {t.platforms[key].label}
            </button>
          ))}
        </div>

        {platformOrder.map((key, idx) => {
          const p = t.platforms[key];
          return (
            <div
              role="tabpanel"
              id={`panel-${key}`}
              aria-labelledby={`tab-${key}`}
              class="inst-panel"
              data-panel={key}
              hidden={idx !== 0}
            >
              <div class="inst-panel__top mono">
                <span class="inst-panel__badge">{p.badge}</span>
              </div>

              <div class="inst-assets">
                {p.items.map((item) => {
                  const asset = release?.assets[item.asset];
                  return (
                    <a
                      class="inst-asset"
                      href={asset?.url ?? RELEASES_URL}
                      data-asset={item.asset}
                      aria-disabled={asset ? undefined : 'true'}
                      rel="noopener"
                    >
                      <div class="inst-asset__info">
                        <strong class="inst-asset__title">{item.title}</strong>
                        <span class="inst-asset__sub">{item.sub}</span>
                        <span class="inst-asset__file mono" data-asset-name>{asset?.name ?? 'GitHub Releases'}</span>
                      </div>
                      <div class="inst-asset__right mono">
                        <span class="inst-asset__size" data-asset-size>{fmtSize(asset?.size)}</span>
                        <span class="inst-asset__dl" aria-hidden="true">↓</span>
                      </div>
                    </a>
                  );
                })}
              </div>

              <p class="inst-panel__note">{p.note}</p>
            </div>
          );
        })}
      </div>

      <!-- 右栏：Docker Compose Hub 构成说明与一键启动 -->
      <div class="inst-hub">
        <div class="inst-hub__head">
          <h3 class="inst-hub__title">{t.hubBoxTitle}</h3>
          <button
            type="button"
            class="inst-copy mono"
            data-copy-btn
            data-label-copy={t.copyBtn}
            data-label-copied={t.copiedBtn}
          >
            {t.copyBtn}
          </button>
        </div>

        <div class="hub-layers" aria-label={lang === 'zh' ? 'Hub 服务构成' : 'Hub service layers'}>
          {t.stackLayers.map((layer, idx) => (
            <div class:list={['hub-layer', idx === 1 && 'hub-layer--brass']}>
              <span class="hub-layer__port mono">{layer.port}</span>
              <strong class="hub-layer__name">{layer.name}</strong>
              <span class="hub-layer__meta">{layer.meta}</span>
            </div>
          ))}
        </div>

        <pre class="inst-code mono"><code data-copy-src>{HUB_SNIPPET}</code></pre>

        <p class="inst-hub__doc mono">
          <a href={DOCS.hub} rel="noopener">{t.hubDocLink}</a>
        </p>
      </div>
    </div>

    <p class="inst-verified reveal">{t.verified}</p>
  </div>
</section>

<style>
  .inst-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
    padding: 11px 16px;
    border-radius: var(--radius-md);
    background: var(--ink-1);
    border: 1px solid var(--line-2);
    font-size: 0.75rem;
    color: var(--fg-dim);
    margin-bottom: 18px;
  }

  .inst-meta strong {
    color: var(--cyan);
  }

  .inst-meta__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .inst-meta__links a {
    text-decoration: none;
  }

  .inst-meta__links a:hover {
    color: var(--fg);
    text-decoration: underline;
  }

  .inst-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 18px;
    align-items: stretch;
  }

  @media (max-width: 980px) {
    .inst-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .inst-downloads,
  .inst-hub {
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-2);
    background: var(--ink-1);
    padding: clamp(20px, 2.6vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .inst-tabs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    padding: 3px;
    border-radius: var(--radius-md);
    background: var(--void);
    border: 1px solid var(--line-2);
    gap: 3px;
  }

  @media (max-width: 560px) {
    .inst-tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .inst-tab {
    padding: 8px 6px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--fg-dim);
    font-size: 0.75rem;
    cursor: pointer;
    text-align: center;
    transition: background 0.18s, color 0.18s;
  }

  .inst-tab:hover {
    color: var(--fg);
    background: var(--ink-2);
  }

  .inst-tab[aria-selected='true'] {
    background: var(--fg);
    color: var(--void);
    font-weight: 650;
  }

  .inst-panel {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .inst-panel[hidden] {
    display: none;
  }

  .inst-panel__badge {
    font-size: 0.72rem;
    color: var(--cyan);
  }

  .inst-assets {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .inst-asset {
    padding: 14px 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--line-2);
    background: var(--void);
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    transition: border-color 0.18s var(--ease), background 0.18s var(--ease), transform 0.18s var(--ease);
  }

  .inst-asset:hover {
    color: var(--fg);
    border-color: var(--cyan);
    background: var(--ink-2);
    transform: translateY(-1px);
  }

  .inst-asset__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .inst-asset__title {
    font-size: 0.92rem;
    font-weight: 580;
    color: var(--fg);
  }

  .inst-asset__sub {
    font-size: 0.8rem;
    color: var(--fg-dim);
  }

  .inst-asset__file {
    font-size: 0.7rem;
    color: var(--cyan);
    overflow-wrap: anywhere;
  }

  .inst-asset__right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    font-size: 0.74rem;
    color: var(--fg-dim);
  }

  .inst-asset__dl {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--fg);
    color: var(--void);
    font-weight: 700;
  }

  .inst-panel__note {
    margin-top: auto;
    font-size: 0.8rem;
    line-height: 1.62;
    color: var(--fg-faint);
  }

  .inst-hub__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .inst-hub__title {
    font-family: var(--f-display);
    font-size: 1.02rem;
    font-weight: 580;
  }

  .inst-copy {
    padding: 5px 11px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-2);
    background: var(--void);
    color: var(--fg);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .inst-copy:hover {
    border-color: var(--cyan);
    color: #ffffff;
  }

  .hub-layers {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hub-layer {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 2px 12px;
    align-items: baseline;
    padding: 10px 13px;
    border-radius: var(--radius-sm);
    background: var(--void);
    border: 1px solid var(--line);
    border-left: 3px solid var(--cyan);
  }

  .hub-layer--brass {
    border-left-color: var(--brass);
  }

  .hub-layer__port {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--cyan);
    grid-row: span 2;
  }

  .hub-layer--brass .hub-layer__port {
    color: var(--brass);
  }

  .hub-layer__name {
    font-size: 0.82rem;
    font-weight: 580;
    color: var(--fg);
  }

  .hub-layer__meta {
    font-size: 0.74rem;
    color: var(--fg-dim);
  }

  @media (max-width: 520px) {
    .hub-layer {
      grid-template-columns: minmax(0, 1fr);
    }
    .hub-layer__port {
      grid-row: auto;
    }
  }

  .inst-code {
    margin: 0;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: #06080c;
    border: 1px solid var(--line);
    font-size: 0.75rem;
    line-height: 1.68;
    color: var(--fg);
    overflow-x: auto;
  }

  .inst-hub__doc {
    margin-top: auto;
    font-size: 0.75rem;
  }

  .inst-hub__doc a {
    color: var(--cyan);
    text-decoration: none;
  }

  .inst-hub__doc a:hover {
    text-decoration: underline;
  }

  .inst-verified {
    margin-top: 18px;
    font-size: 0.79rem;
    line-height: 1.64;
    color: var(--fg-faint);
  }
</style>

<script>
  const dlBox = document.querySelector<HTMLElement>('[data-dl]');
  if (dlBox) {
    const tabs = [...dlBox.querySelectorAll<HTMLButtonElement>('[data-platform]')];
    const panels = [...dlBox.querySelectorAll<HTMLElement>('[data-panel]')];

    const activate = (platform: string, moveFocus = false) => {
      const targetTab = tabs.find((t) => t.dataset.platform === platform);
      if (!targetTab) return;
      for (const tab of tabs) {
        const on = tab === targetTab;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && moveFocus) tab.focus();
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.panel !== platform;
      }
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => activate(tab.dataset.platform!));
      tab.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next >= 0) {
          e.preventDefault();
          activate(tabs[next].dataset.platform!, true);
        }
      });
    });

    document.addEventListener('jiran:platform', (e) => {
      const p = (e as CustomEvent<string>).detail;
      if (p) activate(p);
    });
  }

  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-btn]');
  const copySrc = document.querySelector<HTMLElement>('[data-copy-src]');
  if (copyBtn && copySrc) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copySrc.textContent ?? '');
        copyBtn.textContent = copyBtn.dataset.labelCopied ?? 'Copied';
        setTimeout(() => {
          copyBtn.textContent = copyBtn.dataset.labelCopy ?? 'Copy';
        }, 1800);
      } catch {
        /* ignore clipboard restrictions */
      }
    });
  }
</script>
