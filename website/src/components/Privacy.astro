---
import SectionHead from './SectionHead.astro';
import { CONTENT, type Lang } from '../i18n/content';
import { DOCS } from '../data/product';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = CONTENT[lang].privacy;
---

<section class="section privacy" id="privacy" aria-labelledby="privacy-title">
  <div class="wrap">
    <SectionHead index={5} id="privacy" kicker={t.kicker} title={t.title} intro={t.intro} />

    <div class="membrane">
      <div class="membrane__side membrane__stays reveal">
        <h3 class="note">{t.staysTitle}</h3>
        <ul>
          {t.stays.map((x) => <li><span class="membrane__lock" aria-hidden="true"></span>{x}</li>)}
        </ul>
      </div>
      <div class="membrane__wall" aria-hidden="true">
        <span class="membrane__label mono">{t.boundary}</span>
      </div>
      <div class="membrane__side membrane__crosses reveal" style="--d:.12s">
        <h3 class="note">{t.crossesTitle}</h3>
        <ul>
          {t.crosses.map((x, i) => <li style={`--i:${i}`}><span class="membrane__arrow" aria-hidden="true">→</span>{x}</li>)}
        </ul>
      </div>
    </div>

    <div class="privacy__foot reveal">
      <p>{t.site}</p>
      <a href={DOCS.privacy} rel="noopener">{t.more} ↗</a>
    </div>
  </div>
</section>

<style>
  .membrane {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 120px minmax(0, 1fr);
    margin-top: clamp(56px, 7vw, 96px);
  }
  .membrane__side h3 {
    margin-bottom: 22px;
  }
  .membrane__side ul {
    display: grid;
  }
  .membrane__side li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    font-size: 1.0625rem;
  }
  .membrane__side li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .membrane__lock {
    flex: none;
    width: 9px;
    height: 9px;
    border: 1px solid var(--fg-dim);
  }
  .membrane__stays li {
    color: var(--fg);
  }
  .membrane__crosses li {
    color: var(--fg-dim);
  }
  .membrane__arrow {
    flex: none;
    font-family: var(--f-mono);
    color: var(--celadon);
    transition: transform 0.8s var(--ease-out);
    transition-delay: calc(var(--i) * 80ms + 0.3s);
    transform: translateX(-60px);
    opacity: 0;
  }
  .membrane__crosses:global(.is-in) .membrane__arrow,
  :global(.no-js) .membrane__arrow {
    transform: none;
    opacity: 1;
  }
  .membrane__wall {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .membrane__wall::before {
    content: '';
    width: 1px;
    height: 100%;
    background: repeating-linear-gradient(180deg, var(--fg-dim) 0 2px, transparent 2px 7px);
  }
  .membrane__label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-90deg);
    padding: 6px 12px;
    background: var(--bg);
    font-size: var(--t-micro);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-dim);
    white-space: nowrap;
  }
  .privacy__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px 40px;
    margin-top: clamp(48px, 6vw, 80px);
    padding: 22px 26px;
    border: 1px solid var(--line);
    border-left: 2px solid var(--cinnabar);
  }
  .privacy__foot p {
    color: var(--fg-dim);
    max-width: 52em;
  }
  .privacy__foot a {
    font-size: var(--t-small);
    white-space: nowrap;
  }

  @media (max-width: 800px) {
    .membrane {
      grid-template-columns: 1fr;
    }
    .membrane__wall {
      height: 72px;
      align-items: center;
    }
    .membrane__wall::before {
      width: 100%;
      height: 1px;
      background: repeating-linear-gradient(90deg, var(--fg-dim) 0 2px, transparent 2px 7px);
    }
    .membrane__label {
      transform: translate(-50%, -50%);
    }
  }
</style>
