---
import SectionHead from './SectionHead.astro';
import { CONTENT, type Lang } from '../i18n/content';
import { DOCS } from '../data/product';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = CONTENT[lang].privacy;
---

<section class="section" id="privacy" aria-labelledby="priv-title">
  <div class="wrap">
    <SectionHead id="priv-title" index={t.index} title={t.title} lead={t.lead} />

    <div class="priv-grid">
      <div class="priv-col priv-col--local glass-card reveal">
        <div class="priv-col__head">
          <span class="priv-badge priv-badge--emerald mono">{t.staySub}</span>
          <h3>{t.stayTitle}</h3>
        </div>
        <ul class="priv-items">
          {t.stay.map((item) => (
            <li>
              <strong>{item.k}</strong>
              <p>{item.d}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="priv-col priv-col--hub glass-card reveal">
        <div class="priv-col__head">
          <span class="priv-badge priv-badge--cyan mono">{t.hubSub}</span>
          <h3>{t.hubTitle}</h3>
        </div>
        <ul class="priv-items">
          {t.hub.map((item) => (
            <li>
              <strong>{item.k}</strong>
              <p>{item.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="priv-foot glass-card reveal">
      <p>{t.siteFoot}</p>
      <a class="mono" href={DOCS.privacy} rel="noopener">{t.docLink}</a>
    </div>
  </div>
</section>

<style>
  .priv-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  @media (max-width: 900px) {
    .priv-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .priv-col {
    padding: clamp(22px, 2.8vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .priv-col--local {
    border-color: rgb(52 211 153 / 0.26);
  }

  .priv-col--hub {
    border-color: rgb(56 189 248 / 0.26);
  }

  .priv-col__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .priv-col__head h3 {
    font-size: 1.28rem;
    font-weight: 680;
    letter-spacing: -0.02em;
  }

  .priv-badge {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.67rem;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .priv-badge--emerald {
    background: rgb(52 211 153 / 0.14);
    border: 1px solid rgb(52 211 153 / 0.34);
    color: #6ee7b7;
  }

  .priv-badge--cyan {
    background: rgb(56 189 248 / 0.14);
    border: 1px solid rgb(56 189 248 / 0.34);
    color: #7dd3fc;
  }

  .priv-items {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .priv-items li {
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .priv-items strong {
    display: block;
    font-size: 0.94rem;
    margin-bottom: 4px;
    color: var(--fg);
  }

  .priv-items p {
    font-size: 0.86rem;
    line-height: 1.62;
    color: var(--fg-dim);
  }

  .priv-foot {
    margin-top: 18px;
    padding: 18px 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    font-size: 0.85rem;
    color: var(--fg-dim);
  }

  .priv-foot a {
    font-size: 0.78rem;
    color: var(--cyan);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .priv-foot a {
      white-space: normal;
    }
  }
</style>
