---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Features from './Features.astro';
import Workbench from './Workbench.astro';
import Flow from './Flow.astro';
import Sources from './Sources.astro';
import Install from './Install.astro';
import Footer from './Footer.astro';
import { getRelease } from '../data/release';
import type { Lang } from '../i18n/content';
// 首屏无衬线正文与等宽数字字体预加载；src/integrations/early-hints.mjs 会在构建完成后
// 自动将它们写入 dist/_headers，供 Cloudflare Pages 以 103 Early Hints 提前下发。
import sansLatin from '../../node_modules/@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import monoLatin from '../../node_modules/@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const release = await getRelease();
const preloadFonts = [sansLatin, monoLatin];
---

<Base lang={lang}>
  {preloadFonts.map((href) => <link slot="head" rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  <Nav lang={lang} tag={release?.tag} />
  <main id="main">
    <Hero lang={lang} release={release} />
    <Features lang={lang} />
    <Workbench lang={lang} />
    <Flow lang={lang} />
    <Sources lang={lang} />
    <Install lang={lang} release={release} />
  </main>
  <Footer lang={lang} />
  <script type="application/json" id="release-data" set:html={JSON.stringify(release)} />
</Base>

<script>
  import { initRelease } from '../scripts/release';
  import { REPO } from '../data/product';
  initRelease(REPO);

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }
    },
    { rootMargin: '0px 0px -4% 0px', threshold: 0.01 },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
