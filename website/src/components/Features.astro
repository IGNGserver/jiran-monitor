---
import ModelStage from './ModelStage.astro';
import { CONTENT, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = CONTENT[lang].features;
---

<section class="section" id="features" aria-labelledby="features-title">
  <div class="wrap">
    <header class="sec-head reveal">
      <div class="sec-head__left">
        <span class="eyebrow">{t.index}</span>
        <h2 class="sec-title" id="features-title">{t.title}</h2>
      </div>
      <p class="sec-lead">{t.lead}</p>
    </header>

    <div class="feat-rows">
      <!-- 01A: 五维词元构成与模型成本对比 -->
      <article class="feat-row reveal">
        <div class="feat-row__copy">
          <span class="feat-tag mono">{t.mixBlock.tag}</span>
          <h3 class="feat-row__title">{t.mixBlock.title}</h3>
          <p class="feat-row__body">{t.mixBlock.body}</p>
          <dl class="feat-points">
            {t.mixBlock.points.map((pt) => (
              <div class="feat-point">
                <dt class="mono">{pt.k}</dt>
                <dd class:list={[pt.tone === 'cyan' && 'is-cyan', pt.tone === 'brass' && 'is-brass']}>{pt.v}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="feat-row__visual">
          <ModelStage id="mix" aspect="card" alt={t.mixBlock.alt} caption={t.mixBlock.caption} />
        </div>
      </article>

      <!-- 01B: 26 家配额窗口与独立 Credits -->
      <article class="feat-row feat-row--reverse reveal">
        <div class="feat-row__visual">
          <ModelStage id="quota" aspect="card" alt={t.quotaBlock.alt} caption={t.quotaBlock.caption} />
        </div>

        <div class="feat-row__copy">
          <span class="feat-tag feat-tag--brass mono">{t.quotaBlock.tag}</span>
          <h3 class="feat-row__title">{t.quotaBlock.title}</h3>
          <p class="feat-row__body">{t.quotaBlock.body}</p>
          <dl class="feat-points">
            {t.quotaBlock.points.map((pt) => (
              <div class="feat-point">
                <dt class="mono">{pt.k}</dt>
                <dd class:list={[pt.tone === 'cyan' && 'is-cyan', pt.tone === 'brass' && 'is-brass']}>{pt.v}</dd>
              </div>
            ))}
          </dl>
        </div>
      </article>
    </div>

    <div class="feat-subhead reveal">
      <h3 class="feat-subhead__title">{t.principlesTitle}</h3>
    </div>

    <div class="feat-cards reveal">
      {t.principles.map((card) => (
        <article class="feat-card">
          <span class="feat-card__tag mono">{card.tag}</span>
          <h4 class="feat-card__title">{card.title}</h4>
          <p class="feat-card__body">{card.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .feat-rows {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vw, 76px);
    margin-bottom: clamp(48px, 6vw, 76px);
  }

  .feat-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: clamp(24px, 4vw, 52px);
    align-items: center;
  }

  .feat-row--reverse {
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
  }

  @media (max-width: 960px) {
    .feat-row,
    .feat-row--reverse {
      grid-template-columns: minmax(0, 1fr);
    }

    .feat-row--reverse .feat-row__visual {
      order: 2;
    }

    .feat-row--reverse .feat-row__copy {
      order: 1;
    }
  }

  .feat-row__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .feat-tag {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--cyan);
    background: var(--cyan-soft);
    border: 1px solid rgb(79 195 247 / 0.26);
  }

  .feat-tag--brass {
    color: var(--brass);
    background: var(--brass-soft);
    border-color: rgb(229 169 76 / 0.28);
  }

  .feat-row__title {
    font-family: var(--f-display);
    font-weight: 560;
    font-size: clamp(1.38rem, 2.2vw, 1.92rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
    color: var(--fg);
    text-wrap: balance;
  }

  .feat-row__body {
    font-size: 0.94rem;
    line-height: 1.74;
    color: var(--fg-dim);
  }

  .feat-points {
    margin-top: 4px;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    background: var(--ink-1);
    overflow: hidden;
  }

  .feat-point {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 16px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--line);
    font-size: 0.82rem;
  }

  .feat-point:last-child {
    border-bottom: 0;
  }

  .feat-point dt {
    color: var(--fg-faint);
    font-size: 0.74rem;
  }

  .feat-point dd {
    color: var(--fg);
    font-weight: 500;
  }

  .feat-point dd.is-cyan {
    color: var(--cyan);
  }

  .feat-point dd.is-brass {
    color: var(--brass);
  }

  .feat-subhead {
    margin-bottom: 18px;
  }

  .feat-subhead__title {
    font-family: var(--f-display);
    font-weight: 560;
    font-size: 1.12rem;
    color: var(--fg);
  }

  .feat-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  @media (max-width: 1040px) {
    .feat-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .feat-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .feat-card {
    padding: 20px;
    border-radius: var(--radius-md);
    border: 1px solid var(--line-2);
    background: var(--ink-1);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }

  .feat-card:hover {
    background: var(--ink-2);
    border-color: var(--line-3);
  }

  .feat-card__tag {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--cyan);
  }

  .feat-card__title {
    font-size: 0.98rem;
    font-weight: 580;
    line-height: 1.38;
    color: var(--fg);
  }

  .feat-card__body {
    font-size: 0.83rem;
    line-height: 1.65;
    color: var(--fg-dim);
  }
</style>
