---
interface Props {
  id?: string;
  index: string;
  title: string;
  lead?: string;
}
const { id, index, title, lead } = Astro.props;
---
<header class="sec-head reveal">
  <p class="kicker">
    <span class="kicker__dot" aria-hidden="true"></span>
    <span>{index}</span>
    <span class="kicker__rule" aria-hidden="true"></span>
  </p>
  <div class="sec-head__grid">
    <h2 class="h2" id={id}>{title}</h2>
    {lead && <p class="lead">{lead}</p>}
  </div>
</header>

<style>
  .sec-head {
    margin-bottom: clamp(36px, 5vw, 60px);
  }
  .sec-head__grid {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 980px) {
    .sec-head__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: end;
      gap: 40px;
    }
  }
</style>
