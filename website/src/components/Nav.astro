---
import Mark from './Mark.astro';
import { CONTENT, LANGS, type Lang } from '../i18n/content';
import { REPO_URL } from '../data/product';

interface Props { lang: Lang; tag?: string }
const { lang, tag } = Astro.props;
const t = CONTENT[lang].nav;
const sw = LANGS[lang];
---
<header class="site-nav" data-site-nav>
  <div class="wrap site-nav__inner">
    <a class="site-nav__brand" href="#top">
      <Mark size={30} />
      <span class="site-nav__word">
        <span class="site-nav__name">{t.brand}</span>
        <span class="site-nav__tag mono" data-release-tag>{tag ?? 'v1.7'}</span>
      </span>
    </a>

    <nav class="site-nav__links" aria-label={lang === 'zh' ? '主导航' : 'Primary'}>
      <a href="#workbench">{t.workbench}</a>
      <a href="#capabilities">{t.capabilities}</a>
      <a href="#architecture">{t.architecture}</a>
      <a href="#principles">{t.principles}</a>
      <a href="#privacy">{t.privacy}</a>
      <a href="#sources">{t.sources}</a>
    </nav>

    <div class="site-nav__actions">
      <a
        class="site-nav__lang mono"
        href={LANGS[sw.switchTo].path}
        hreflang={LANGS[sw.switchTo].htmlLang}
        aria-label={lang === 'zh' ? 'Switch to English' : '切换至简体中文'}
      >
        {sw.switchLabel}
      </a>
      <a class="site-nav__gh" href={REPO_URL} rel="noopener" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.02c-3.2.7-3.88-1.38-3.88-1.38-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.02 11.02 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.77.12 3.06.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.4-5.27 5.69.42.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
        </svg>
      </a>
      <a class="site-nav__cta" href="#install">{t.download}</a>
    </div>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 90;
    height: var(--nav-h);
    background: rgb(6 10 20 / 0.72);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    border-bottom: 1px solid rgb(148 184 255 / 0.1);
  }

  .site-nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-nav__word {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .site-nav__name {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .site-nav__tag {
    font-size: 0.68rem;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgb(56 189 248 / 0.12);
    border: 1px solid rgb(56 189 248 / 0.28);
    color: var(--cyan);
  }

  .site-nav__links {
    display: none;
    align-items: center;
    gap: clamp(14px, 2vw, 26px);
    font-size: 0.875rem;
    color: var(--fg-dim);
  }

  .site-nav__links a {
    text-decoration: none;
    padding: 6px 2px;
    transition: color 0.18s;
  }

  .site-nav__links a:hover {
    color: var(--fg);
  }

  @media (min-width: 1024px) {
    .site-nav__links {
      display: flex;
    }
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .site-nav__lang,
  .site-nav__gh {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    padding: 0 10px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: rgb(13 21 39 / 0.6);
    font-size: 0.75rem;
    color: var(--fg-dim);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .site-nav__gh {
    width: 34px;
    padding: 0;
  }

  .site-nav__lang:hover,
  .site-nav__gh:hover {
    color: var(--fg);
    border-color: var(--line-2);
    background: rgb(20 32 58 / 0.85);
  }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 14px;
    border-radius: 8px;
    background: linear-gradient(135deg, #38bdf8 0%, #0a84ff 100%);
    color: #030712;
    font-size: 0.8125rem;
    font-weight: 650;
    text-decoration: none;
    transition: filter 0.2s, transform 0.2s;
  }

  .site-nav__cta:hover {
    color: #030712;
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  @media (max-width: 420px) {
    .site-nav__tag {
      display: none;
    }
    .site-nav__cta {
      padding: 0 10px;
      font-size: 0.78rem;
    }
  }
</style>
