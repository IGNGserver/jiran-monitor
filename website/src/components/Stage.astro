---
import { getImage } from 'astro:assets';
import heroWide from '../assets/renders/hero.webp';
import heroPortrait from '../assets/renders/hero-portrait.webp';
import type { Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === 'zh';

const wideAvif = await Promise.all([960, 1600, 2400].map((w) => getImage({ src: heroWide, width: w, format: 'avif', quality: 62 })));
const wideWebp = await Promise.all([960, 1600, 2400].map((w) => getImage({ src: heroWide, width: w, format: 'webp', quality: 82 })));
const tallAvif = await Promise.all([600, 900, 1080].map((w) => getImage({ src: heroPortrait, width: w, format: 'avif', quality: 62 })));
const tallWebp = await Promise.all([600, 900, 1080].map((w) => getImage({ src: heroPortrait, width: w, format: 'webp', quality: 82 })));

const srcset = (set: typeof wideWebp) => set.map((i) => `${i.src} ${i.attributes.width}w`).join(', ');

// 注意：SPEC.layers 自底(0: ingest)向顶(4: quota)排列
const tags = zh
  ? [
      { tagIdx: 4, code: '01 // QUOTA_CROWN', label: '蓝宝石双弧表冠 · 168 刻周一表圈', tone: 'cyan' },
      { tagIdx: 3, code: '02 // CREDITS_ROTOR', label: '偏心黄铜 Credits 副盘 · AES 锁芯', tone: 'brass' },
      { tagIdx: 2, code: '03 // COST_DRUM', label: '里程鼓轮 · 48 齿汇率差速环', tone: 'brass' },
      { tagIdx: 1, code: '04 // PRISM_5WAY', label: '五棱石英分光镜 · 游标出处环', tone: 'cyan' },
      { tagIdx: 0, code: '05 // INGEST_IRIS', label: '59 槽光纤底座 · 12 叶零外泄光阑', tone: 'cyan' },
    ]
  : [
      { tagIdx: 4, code: '01 // QUOTA_CROWN', label: 'Sapphire Dual-Arc Crown · 168-Tick Bezel', tone: 'cyan' },
      { tagIdx: 3, code: '02 // CREDITS_ROTOR', label: 'Off-Axis Brass Credits Rotor · AES Pins', tone: 'brass' },
      { tagIdx: 2, code: '03 // COST_DRUM', label: 'Token Odometer · 48-Tooth FX Ring', tone: 'brass' },
      { tagIdx: 1, code: '04 // PRISM_5WAY', label: '5-Way Quartz Splitter · Vernier Ring', tone: 'cyan' },
      { tagIdx: 0, code: '05 // INGEST_IRIS', label: '59-Slot Fiber Base · Zero-Egress Iris', tone: 'cyan' },
    ];
---

<div class="stage" data-stage aria-hidden="true">
  <picture class="stage__poster">
    <source media="(max-aspect-ratio: 4/5)" type="image/avif" srcset={srcset(tallAvif)} sizes="100vw" />
    <source media="(max-aspect-ratio: 4/5)" type="image/webp" srcset={srcset(tallWebp)} sizes="100vw" />
    <source type="image/avif" srcset={srcset(wideAvif)} sizes="100vw" />
    <img
      src={wideWebp[1].src}
      srcset={srcset(wideWebp)}
      sizes="100vw"
      alt=""
      width="2560"
      height="1440"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <canvas class="stage__canvas"></canvas>
  <div class="stage__shade"></div>

  <svg class="stage__lead">
    <line data-lead x1="0" y1="0" x2="0" y2="0" />
  </svg>

  <div class="stage__tags">
    {tags.map((tag) => (
      <span class="tag3d mono" data-tag={tag.tagIdx} data-tone={tag.tone}>
        <i class="tag3d__dot"></i>
        <span class="tag3d__code">{tag.code}</span>
        <span class="tag3d__txt">{tag.label}</span>
      </span>
    ))}
  </div>
</div>

<style is:global>
  .stage {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background: var(--void);
    transition: opacity 0.24s linear;
  }

  .stage__poster,
  .stage__poster img,
  .stage__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .stage__poster img {
    object-fit: cover;
    object-position: 64% 46%;
    transition: opacity 0.85s var(--ease);
  }

  @media (max-aspect-ratio: 4/5) {
    .stage__poster img {
      object-position: 50% 34%;
    }
  }

  .stage__canvas {
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }

  .stage.is-live .stage__canvas {
    opacity: 1;
  }

  .stage.is-live .stage__poster img {
    opacity: 0;
  }

  /* 无 WebGL 或开启减少动态时：海报仅驻留首屏，不遮挡或穿透后续章节 */
  html.no-gl .stage {
    position: absolute;
    height: 100svh;
    opacity: 1 !important;
  }

  /* 暗室左侧与顶底光学渐晕：保证正文对比度 > 15:1，右侧机芯通透呈现 */
  .stage__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(5 6 8 / 0.96) 0%, rgb(5 6 8 / 0.86) 38%, rgb(5 6 8 / 0.24) 66%, rgb(5 6 8 / 0.06) 100%),
      linear-gradient(180deg, rgb(5 6 8 / 0.86) 0%, rgb(5 6 8 / 0) 16%),
      linear-gradient(0deg, var(--void) 0%, rgb(5 6 8 / 0.65) 14%, rgb(5 6 8 / 0) 32%);
  }

  @media (max-width: 960px) {
    .stage__shade {
      background:
        linear-gradient(180deg, rgb(5 6 8 / 0.56) 0%, rgb(5 6 8 / 0.78) 54%, var(--void) 100%);
    }
  }

  .stage__lead {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .stage__lead line {
    stroke: rgb(86 204 242 / 0.5);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    opacity: 0;
    transition: opacity 0.22s var(--ease);
  }

  @media (max-width: 900px) {
    .stage__lead,
    .stage__tags {
      display: none;
    }
  }

  .stage__tags {
    position: absolute;
    inset: 0;
  }

  .tag3d {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px;
    border-radius: 2px;
    background: rgb(9 11 15 / 0.9);
    border: 1px solid var(--line-2);
    font-size: 0.67rem;
    letter-spacing: 0.03em;
    color: var(--fg);
    white-space: nowrap;
    opacity: 0;
    will-change: transform, opacity;
    transition: opacity 0.22s var(--ease), border-color 0.22s var(--ease);
  }

  .tag3d.is-focus[data-tone='cyan'] {
    border-color: var(--cyan);
    box-shadow: 0 0 24px -8px rgb(86 204 242 / 0.45);
  }
  .tag3d.is-focus[data-tone='brass'] {
    border-color: var(--brass);
    box-shadow: 0 0 24px -8px rgb(229 169 76 / 0.45);
  }

  .tag3d__dot {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
  }
  .tag3d[data-tone='brass'] .tag3d__dot {
    background: var(--brass);
    box-shadow: 0 0 8px var(--brass);
  }

  .tag3d__code {
    color: var(--cyan);
    font-size: 0.61rem;
    letter-spacing: 0.1em;
  }
  .tag3d[data-tone='brass'] .tag3d__code {
    color: var(--brass);
  }

  .tag3d__txt {
    color: var(--fg-dim);
  }
</style>

<script>
  import { boot } from '../scripts/meter/director';
  boot();
</script>
