---
import { getImage } from 'astro:assets';
import explodedSrc from '../assets/renders/exploded.webp';
import { CONTENT, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = CONTENT[lang].anatomy;
const zh = lang === 'zh';

const expAvif = await getImage({ src: explodedSrc, width: 1120, format: 'avif', quality: 65 });
const expWebp = await getImage({ src: explodedSrc, width: 1120, format: 'webp', quality: 84 });
---

<section class="anat" id="anatomy" data-idx={t.numeral} aria-labelledby="anat-title">
  <div class="anat__sticky">
    <div class="wrap anat__viewport">
      <div class="anat__col">
        <!-- 概览导言：刚滚入剖面段时呈现，开始逐层聚焦后折叠为紧凑眉标 -->
        <header class="anat__intro">
          <span class="eyebrow">{t.index}</span>
          <h2 class="anat__heading" id="anat-title">{t.title}</h2>
          <p class="anat__lead">{t.lead}</p>
          <p class="anat__hint mono">
            <span>↓ {zh ? '继续向下滚动 · 逐层检视五组机械总成' : 'SCROLL TO INSPECT ALL FIVE ASSEMBLIES'}</span>
          </p>
        </header>

        <!-- 静态爆炸渲染图：仅在无 WebGL / 减少动态 / 窄屏下呈现 -->
        <figure class="anat__static-fig">
          <picture>
            <source type="image/avif" srcset={expAvif.src} />
            <img
              src={expWebp.src}
              alt={zh ? 'JR-01 计量机芯五层爆炸剖面图' : 'JR-01 five-layer exploded metrology core'}
              width="1120"
              height="1280"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>

        <!-- 五层光学与账本铁律面板（SVG 虚线引线自右侧锚定至三维层） -->
        <div class="anat__panel" data-anat-panel>
          {t.layers.map((layer, idx) => (
            <article class:list={['anat__card', idx === 0 && 'is-first']} data-step={idx} data-layer-id={layer.id}>
              <div class="anat__card-bar mono">
                <span class="anat__step">{layer.step}</span>
                <span class="anat__part">{layer.part}</span>
                <span class="reg" aria-hidden="true"></span>
              </div>

              <div class="anat__card-body">
                <h3 class="anat__card-title">{layer.title}</h3>
                <p class="anat__code mono">
                  <span class="anat__code-k">INVARIANT //</span>
                  <code>{layer.invariantCode}</code>
                </p>
                <p class="anat__desc">{layer.body}</p>

                <dl class="anat__metrics">
                  {layer.metrics.map((m) => (
                    <div class="anat__metric" data-tone={m.tone}>
                      <dt class="mono">{m.k}</dt>
                      <dd>{m.v}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </article>
          ))}
        </div>

        <!-- 底部可点击五层导轨 -->
        <nav class="anat__rail mono" aria-label={zh ? '机芯层级跳转' : 'Jump to assembly layer'}>
          {t.layers.map((layer, idx) => (
            <button type="button" class="anat__rail-btn" data-rail={idx} aria-current={idx === 0 ? 'true' : 'false'}>
              <span class="anat__rail-n">0{idx + 1}</span>
              <span class="anat__rail-id">{layer.id.toUpperCase()}</span>
            </button>
          ))}
        </nav>
      </div>
    </div>
  </div>
</section>

<style>
  .anat {
    position: relative;
    z-index: 2;
    height: calc(100vh + 5 * 84vh);
    border-top: 1px solid var(--line);
  }

  .anat__sticky {
    position: sticky;
    top: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-h);
    padding-bottom: 24px;
  }

  .anat__viewport {
    width: var(--wrap);
    display: grid;
    grid-template-columns: minmax(0, 520px) minmax(0, 1fr);
    align-items: center;
  }

  .anat__col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .anat__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .anat__heading {
    font-family: var(--f-display);
    font-weight: 280;
    font-size: clamp(1.72rem, 3vw, 2.55rem);
    line-height: 1.15;
    letter-spacing: -0.028em;
    color: var(--fg);
    text-wrap: balance;
  }

  :lang(zh) .anat__heading {
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.24;
  }

  .anat__lead {
    font-size: 0.94rem;
    line-height: 1.68;
    color: var(--fg-dim);
  }

  .anat__hint {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--cyan);
    padding-top: 4px;
  }

  /* 当进入逐层步进状态（step >= 0）时，桌面端收起长导言，把完整视口让给当前层卡片 */
  @media (min-width: 900px) {
    html:not(.no-gl) .anat.is-stepping .anat__lead,
    html:not(.no-gl) .anat.is-stepping .anat__hint {
      display: none;
    }
    html:not(.no-gl) .anat.is-stepping .anat__heading {
      font-size: 1.18rem;
      color: var(--fg-dim);
    }
    html:not(.no-gl) .anat:not(.is-stepping) .anat__panel {
      opacity: 0;
      pointer-events: none;
      max-height: 0;
      overflow: hidden;
    }
  }

  .anat__static-fig {
    display: none;
    margin: 0;
    border: 1px solid var(--line);
    background: #040507;
  }

  .anat__static-fig img {
    width: 100%;
    max-width: 440px;
    height: auto;
    margin-inline: auto;
  }

  .anat__panel {
    position: relative;
    transition: opacity 0.3s var(--ease);
  }

  @media (min-width: 900px) {
    html:not(.no-gl) .anat__card {
      display: none;
    }
    html:not(.no-gl) .anat__card.is-active {
      display: block;
      animation: anatFade 0.32s var(--ease);
    }
  }

  @keyframes anatFade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .anat__card {
    border: 1px solid var(--line-2);
    background: rgb(9 11 15 / 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .anat__card-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--line);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }

  .anat__card-bar .reg {
    margin-left: auto;
  }

  .anat__step {
    color: var(--cyan);
    font-weight: 600;
  }

  .anat__card[data-layer-id='credits'] .anat__step,
  .anat__card[data-layer-id='drum'] .anat__step {
    color: var(--brass);
  }

  .anat__part {
    color: var(--fg-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .anat__card-body {
    padding: 18px 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .anat__card-title {
    font-family: var(--f-display);
    font-weight: 420;
    font-size: clamp(1.12rem, 1.55vw, 1.34rem);
    line-height: 1.34;
    color: var(--fg);
  }

  .anat__code {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    background: var(--ink-2);
    border-left: 2px solid var(--cyan);
    font-size: 0.7rem;
    color: var(--fg);
  }

  .anat__card[data-layer-id='credits'] .anat__code,
  .anat__card[data-layer-id='drum'] .anat__code {
    border-left-color: var(--brass);
  }

  .anat__code-k {
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
  }

  .anat__code code {
    font-family: inherit;
    color: var(--cyan);
    overflow-wrap: anywhere;
  }

  .anat__card[data-layer-id='credits'] .anat__code code,
  .anat__card[data-layer-id='drum'] .anat__code code {
    color: var(--brass);
  }

  .anat__desc {
    font-size: 0.86rem;
    line-height: 1.66;
    color: var(--fg-dim);
  }

  .anat__metrics {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--line);
    border: 1px solid var(--line);
    gap: 1px;
    margin-top: 2px;
  }

  .anat__metric {
    background: var(--ink-1);
    padding: 8px 11px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
  }

  .anat__metric dt {
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--fg-faint);
  }

  .anat__metric dd {
    font-size: 0.78rem;
    font-weight: 520;
    color: var(--fg);
  }

  .anat__metric[data-tone='cyan'] dd {
    color: var(--cyan);
  }

  .anat__metric[data-tone='brass'] dd {
    color: var(--brass);
  }

  /* 底部五层跳转导轨 */
  .anat__rail {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    background: var(--line);
    border: 1px solid var(--line-2);
    gap: 1px;
  }

  .anat__rail-btn {
    padding: 8px 6px;
    border: 0;
    background: rgb(9 11 15 / 0.9);
    color: var(--fg-faint);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    transition: background 0.18s var(--ease), color 0.18s var(--ease);
  }

  .anat__rail-btn:hover {
    background: var(--ink-2);
    color: var(--fg);
  }

  .anat__rail-btn[aria-current='true'] {
    background: var(--ink-3);
    color: var(--cyan);
    box-shadow: 0 -2px 0 0 var(--cyan) inset;
  }

  .anat__rail-n {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
  }

  .anat__rail-id {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 窄屏与无 WebGL / 减少动态静态模式：展示 Cycles 高清爆炸剖面图 + 完整纵向五层列表 */
  @media (max-width: 899px) {
    .anat {
      height: auto;
      background: var(--void);
      padding-block: clamp(76px, 10vw, 112px);
    }
    .anat__sticky {
      position: static;
      min-height: 0;
      padding: 0;
    }
    .anat__viewport {
      grid-template-columns: minmax(0, 1fr);
    }
    .anat__hint,
    .anat__rail {
      display: none;
    }
    .anat__static-fig {
      display: block;
    }
    .anat__panel {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
  }

  :global(html.no-gl) .anat {
    height: auto;
    background: var(--void);
    padding-block: clamp(88px, 11vw, 140px);
  }
  :global(html.no-gl) .anat__sticky {
    position: static;
    min-height: 0;
    padding: 0;
  }
  :global(html.no-gl) .anat__viewport {
    grid-template-columns: minmax(0, 1fr);
  }
  :global(html.no-gl) .anat__hint,
  :global(html.no-gl) .anat__rail {
    display: none;
  }
  :global(html.no-gl) .anat__static-fig {
    display: block;
  }
  :global(html.no-gl) .anat__panel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 14px;
  }
</style>
