---
import SectionHead from './SectionHead.astro';
import { CONTENT, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = CONTENT[lang].questions;
---

<section class="section" id="capabilities" aria-labelledby="cap-title">
  <div class="wrap">
    <SectionHead id="cap-title" index={t.index} title={t.title} lead={t.lead} />

    <div class="cap-grid">
      {t.items.map((item, idx) => (
        <article class="cap-card glass-card reveal">
          <div class="cap-card__head">
            <span class="cap-card__idx mono">0{idx + 1}</span>
            <span class="cap-card__tag mono">{item.tag}</span>
          </div>
          <h3 class="cap-card__q">{item.q}</h3>
          <p class="cap-card__a">{item.a}</p>
          <dl class="cap-card__metrics">
            {item.metrics.map((m) => (
              <div class="cap-card__metric">
                <dt>{m.k}</dt>
                <dd class="mono">{m.v}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  @media (max-width: 1024px) {
    .cap-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .cap-card {
    padding: clamp(22px, 2.6vw, 30px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: border-color 0.25s, transform 0.25s var(--ease-out);
  }

  .cap-card:hover {
    border-color: var(--line-2);
    transform: translateY(-2px);
  }

  .cap-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .cap-card__idx {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--cyan);
    padding: 3px 8px;
    border-radius: 6px;
    background: rgb(56 189 248 / 0.12);
    border: 1px solid rgb(56 189 248 / 0.24);
  }

  .cap-card__tag {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--fg-faint);
  }

  .cap-card__q {
    font-size: var(--t-h3);
    font-weight: 680;
    line-height: 1.28;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .cap-card__a {
    font-size: 0.925rem;
    line-height: 1.68;
    color: var(--fg-dim);
    flex: 1;
  }

  .cap-card__metrics {
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .cap-card__metric {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 12px;
    font-size: 0.79rem;
  }

  .cap-card__metric dt {
    color: var(--fg-faint);
  }

  .cap-card__metric dd {
    font-size: 0.75rem;
    color: #e2e8f0;
    text-align: right;
  }
</style>
