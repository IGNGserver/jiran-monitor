---
import Mark from './Mark.astro';
import { CONTENT, LANGS, type Lang } from '../i18n/content';
import { DOCS, RELEASES_URL, REPO_URL } from '../data/product';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = CONTENT[lang].footer;
const nav = CONTENT[lang].nav;
const sw = LANGS[lang];
---

<footer class="site-foot">
  <div class="wrap site-foot__grid">
    <div class="site-foot__brand">
      <a class="site-foot__logo" href="#top">
        <Mark size={28} />
        <span>{nav.brand}</span>
        <span class="site-foot__sub mono">{nav.sub}</span>
      </a>
      <p class="site-foot__tag">{t.tagline}</p>
      <p class="site-foot__meta mono">{t.mit}</p>
      <p class="site-foot__credit">
        {t.tokscalePre}
        <a href={DOCS.tokscale} rel="noopener">tokscale</a>.
      </p>
    </div>

    <div class="site-foot__col">
      <h3 class="mono">{t.colProduct}</h3>
      <ul>
        <li><a href="#features">{nav.features}</a></li>
        <li><a href="#workbench">{nav.workbench}</a></li>
        <li><a href="#architecture">{nav.architecture}</a></li>
        <li><a href="#sources">{nav.sources}</a></li>
        <li><a href="#install">{nav.download}</a></li>
      </ul>
    </div>

    <div class="site-foot__col">
      <h3 class="mono">{t.colDocs}</h3>
      <ul>
        <li><a href={lang === 'zh' ? DOCS.readmeZh : DOCS.readme} rel="noopener">{t.links.readme}</a></li>
        <li><a href={DOCS.tools} rel="noopener">{t.links.tools}</a></li>
        <li><a href={DOCS.hub} rel="noopener">{t.links.hub}</a></li>
        <li><a href={DOCS.agent} rel="noopener">{t.links.agent}</a></li>
        <li><a href={DOCS.wsl} rel="noopener">{t.links.wsl}</a></li>
        <li><a href={DOCS.privacy} rel="noopener">{t.links.privacy}</a></li>
      </ul>
    </div>

    <div class="site-foot__col">
      <h3 class="mono">{t.colCommunity}</h3>
      <ul>
        <li><a href={REPO_URL} rel="noopener">GitHub ({REPO_URL.replace('https://github.com/', '')})</a></li>
        <li><a href={RELEASES_URL} rel="noopener">{t.links.releases}</a></li>
        <li><a href={DOCS.api} rel="noopener">{t.links.api}</a></li>
        <li><a href={DOCS.license} rel="noopener">{t.links.license}</a></li>
        <li><a href={LANGS[sw.switchTo].path} hreflang={LANGS[sw.switchTo].htmlLang}>{LANGS[sw.switchTo].label}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line);
    background: #06080c;
    padding-block: clamp(52px, 7vw, 80px);
  }

  .site-foot__grid {
    display: grid;
    grid-template-columns: 1.45fr repeat(3, minmax(0, 1fr));
    gap: 32px 28px;
  }

  @media (max-width: 900px) {
    .site-foot__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .site-foot__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .site-foot__brand {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .site-foot__logo {
    display: inline-flex;
    align-items: baseline;
    gap: 9px;
    font-weight: 600;
    font-size: 1.06rem;
    text-decoration: none;
  }

  .site-foot__sub {
    font-size: 0.74rem;
    color: var(--fg-faint);
    font-weight: 450;
  }

  .site-foot__tag {
    font-size: 0.86rem;
    color: var(--fg-dim);
    max-width: 34ch;
  }

  .site-foot__meta {
    font-size: 0.72rem;
    color: var(--fg-faint);
  }

  .site-foot__credit {
    font-size: 0.76rem;
    color: var(--fg-faint);
  }

  .site-foot__credit a {
    color: var(--fg-dim);
  }

  .site-foot__col h3 {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
    margin-bottom: 12px;
  }

  .site-foot__col ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.84rem;
    color: var(--fg-dim);
  }

  .site-foot__col a {
    text-decoration: none;
  }

  .site-foot__col a:hover {
    color: var(--fg);
  }
</style>
