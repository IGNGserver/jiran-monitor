# 计然 (Jiran) — environment configuration.
# Copy to .env (gitignored) and fill in. Only needed for the hub and the
# headless agent; the desktop app can also read these as first-run defaults
# before its GUI settings take over.
#
# The historical TOKEN_MONITOR_* names remain fully supported (they win when
# both prefixes are set); JIRAN_* is the canonical prefix after the 计然 rename.

# Hub URL — required for the agent and for the desktop app in sync mode.
# Leave empty for single-device local mode (the app reads files directly, no hub).
# Example: https://hub.example.com
JIRAN_HUB_URL=

# Optional device-side fleet calendar override (IANA name, e.g. Asia/Shanghai).
# Normally set once on the Hub (docker-compose TOKEN_MONITOR_FLEET_TIMEZONE) and
# learned by every device from the ingest response; this variable pre-seeds or
# overrides it on a device. Setting it changes which day the device's today/month
# windows belong to and re-keys its local day-keyed history once.
JIRAN_FLEET_TIMEZONE=

# Single-user Hub key. Generate it with `openssl rand -hex 32`. The same key is
# used by the Hub and every connected app/agent; it grants read, ingest, and
# administrative access, including manually managed quota accounts.
JIRAN_SECRET=

# Older split admin/viewer/device variables are no longer supported. They must
# not be used as alternate users; configure the single owner key above.

# Optional legacy override for Hub account credential encryption. Leave empty in
# single-key mode so the encryption key is derived from JIRAN_SECRET.
# Changing the effective key makes stored account credentials undecryptable;
# users must manually log in again.
JIRAN_HUB_CREDENTIAL_KEY=

# Optional override for the Google OAuth client secret used by the Hub's
# Antigravity (agy) account flow. The default is the public installed-app secret
# that ships with the Antigravity CLI, so most operators never set this; set it
# only if Google rotates that secret.
AGY_OAUTH_CLIENT_SECRET=

# Remote HTTP is refused by default. Enable only for a trusted LAN/VPN when TLS
# cannot yet be configured. Android release builds always require HTTPS.
JIRAN_ALLOW_INSECURE_HTTP=0

# Hub Docker image tag from GHCR (ghcr.io/igngserver/jiran-hub).
# Default latest tracks the newest formal release. Pin for production, e.g. 0.47.0 or v0.47.0.
JIRAN_VERSION=latest

# MySQL Hub storage. Used by the Docker Compose Hub. Replace
# both example password values with unique strong passwords before deployment.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=token_monitor
MYSQL_USER=token_monitor
MYSQL_PASSWORD=replace-with-a-strong-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_CONNECTION_LIMIT=10

# Upstream catalog used only when `tokscale pricing` cannot reach one of its
# own public pricing sources. The default is models.dev, which tokscale also
# consults. Override only with an equivalent HTTPS JSON catalog endpoint.
TOKSCALE_PRICING_CATALOG_URL=https://models.dev/api.json

# Docker-backed MySQL integration tests. Start with
# `docker compose -f docker-compose.test.yml up -d` before `npm run test:mysql`.
MYSQL_TEST_HOST=127.0.0.1
MYSQL_TEST_PORT=17322
MYSQL_TEST_DATABASE=token_monitor_test
MYSQL_TEST_USER=token_monitor_test
MYSQL_TEST_PASSWORD=replace-with-a-strong-test-password
MYSQL_TEST_ROOT_PASSWORD=replace-with-a-strong-test-root-password
MYSQL_TEST_ENABLED=0

# Device identifier. Optional — defaults to the machine hostname.
JIRAN_DEVICE_ID=

# Collection itself is fixed: every supported tool is tracked, and the file watchers,
# usage history, the deleted-session archive, Projects and the WSL scan always run.
# The old JIRAN_COLLECTION_MODE / INTERVAL_MS / WATCH / WATCH_DEBOUNCE_MS /
# PROJECTS_ENABLED / HISTORY_ENABLED / SESSION_USAGE_ARCHIVE_ENABLED /
# SYNC_UPLOAD_INTERVAL_MS knobs and their matching agent flags are gone; the agent
# warns and ignores them, because a narrower collection no longer has any surface
# that could turn it back on.

# Pause collection at start-up. Desktop first-run default; the switch and the tray
# item both override it at runtime. Set to 1 to start with collection stopped.
JIRAN_COLLECTION_PAUSED=

# Desktop window behaviour, applied as first-run defaults (the Settings page owns
# them afterwards). Closing the window hides it to the tray, and a login-item launch
# starts hidden instead of opening a window at sign-in.
JIRAN_CLOSE_TO_TRAY=1
JIRAN_START_HIDDEN=1

# AI Tool Limits — quota data is now owned by the Hub. Devices and headless
# agents no longer discover local developer-tool accounts or upload credentials;
# add accounts manually in the Hub and let it refresh/distribute the results.
# Ignored. Devices no longer hold a quota-probe switch; quota data always comes
# from the Hub. Kept only so an existing .env does not fail to parse.
JIRAN_LIMITS_ENABLED=

# Ignored. Hub accounts choose their own providers; this filter no longer selects
# anything on the device.
JIRAN_LIMIT_PROVIDERS=

# Legacy local source policy. Device-side automatic account discovery has been
# removed; changing this value does not restore it.
JIRAN_LIMIT_PROVIDER_AUTO_DETECT_DISABLED=

# Legacy local refresh knobs. Hub refresh scheduling is controlled by the Hub;
# these values do not re-enable device-side quota probing.
JIRAN_LIMITS_REFRESH_MODE=
JIRAN_LIMITS_REFRESH_MS=

# Legacy local quota options. They are retained only so older `.env` files do
# not fail parsing; device-side account discovery and quota probing are removed.
JIRAN_OPENCODE_LOCAL_LIMITS=

# Legacy local provider credential; add the account manually to the Hub instead.
JIRAN_OPENCODE_API_KEY=

# Legacy local account toggle; it cannot enable device-side account discovery.
JIRAN_OPENCODE_AMBIENT=

# Legacy local quota credential. Device-side discovery and quota probing are
# removed; add a Grok account manually in the Hub instead.
GROK_BEARER_TOKEN=

# Optional proxy for Grok web billing. Lowercase variants are also supported
# and take precedence; NO_PROXY/no_proxy bypasses matching hosts.
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=
NO_PROXY=

# Legacy local quota credential. Add a DeepSeek account manually in the Hub;
# this variable is retained only so older `.env` files remain parseable.
DEEPSEEK_API_KEY=

# Legacy local quota credential. Add one or more named OpenRouter accounts
# manually in the Hub; this variable is retained only for old configurations.
OPENROUTER_API_KEY=

# Legacy local quota credential. Add a MiniMax account manually in the Hub;
# this variable is retained only for old configurations.
MINIMAX_CODING_API_KEY=

# Legacy local quota credential. Add a Copilot account manually in the Hub;
# this variable and GITHUB_COPILOT_TOKEN remain parse-compatible only.
COPILOT_API_TOKEN=

# Legacy local quota credential. Add a Z.ai account manually in the Hub.
# Z_AI_API_KEY, GLM_API_KEY, and ZHIPU_API_KEY are also accepted for compatibility.
# JIRAN_ZAI_API_REGION may be "global" (api.z.ai) or "bigmodel-cn" (open.bigmodel.cn).
ZAI_API_KEY=
JIRAN_ZAI_API_REGION=global

# GLM Team Plan (BigModel CN only). ZAI_TEAM_API_KEY or BIGMODEL_TEAM_API_KEY
# supplies the team API key separately from the personal GLM provider. The
# Organization and project identifiers are entered with the Hub account when
# needed; these environment variables remain parse-compatible only.
ZAI_TEAM_API_KEY=
ZAI_TEAM_ORGANIZATION_ID=
ZAI_TEAM_PROJECT_ID=

# Legacy local quota credentials. Add a Volcengine account manually in the Hub.
# Paste an Ark API key (ark-...), or an access key ID (AKLT...) plus secret there.
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_REGION=cn-beijing

# Legacy local Qoder quota credential. Add a Qoder account manually in the Hub;
# browser capture and local cookie discovery are removed from the device.
# JIRAN_QODER_SITE may be "global" or "cn" for older configurations.
QODER_COOKIE=
JIRAN_QODER_SITE=global
JIRAN_QODER_COOKIE_MODE=

# Optional Qoder local-adapter path overrides, one set per tracked site. Both
# sites (`qoder` international, `qodercn` China) are always tracked; these
# overrides only relocate where their files are read from.
# The transcript tree is the primary source in current builds; the defaults are
# ~/.qoder/projects/**/*.jsonl and $QODERCN_CONFIG_DIR/projects/**/*.jsonl (or
# ~/.qoder-cn/projects/**/*.jsonl), where QODERCN_CONFIG_DIR is Qoder CN's own
# optional config-root override. The two SQLite sources are auto-detected when
# present: the desktop main.sqlite below the platform application-support
# directory (com.qoder.app.stable / com.qodercn.app.stable) and the legacy
# Qoder/ or QoderCN/SharedClientCache/cache/db/local.db. Override only when a
# path is relocated.
JIRAN_QODER_TRANSCRIPTS_DIR=
JIRAN_QODER_MAIN_DB_PATH=
JIRAN_QODER_DB_PATH=
QODERCN_CONFIG_DIR=
JIRAN_QODER_CN_TRANSCRIPTS_DIR=
JIRAN_QODER_CN_MAIN_DB_PATH=
JIRAN_QODER_CN_DB_PATH=

# Legacy local quota credential. Add an Ollama account manually in the Hub.
OLLAMA_COOKIE=

# Legacy local quota credential. Add a Kimi account manually in the Hub.
KIMI_CODE_API_KEY=
# Legacy local quota credential retained for old configurations only.
KIMI_AUTH_TOKEN=

# Legacy local third-party profiles. Add HTTPS third-party accounts manually in
# the Hub; these environment variables are retained only for old configurations.
JIRAN_NEWAPI_BASE_URL=
JIRAN_NEWAPI_ACCESS_TOKEN=
JIRAN_NEWAPI_USER_ID=
JIRAN_NEWAPI_API_KEY=


# Gemini Code Assist quota renewal. Google's token endpoint requires an OAuth
# client id AND secret to redeem a refresh token, and this project deliberately
# ships neither — register your own OAuth client (type "Desktop app") in Google
# Cloud, then set both here. Only needed to auto-renew a Gemini account; a pasted
# access token works without them, and without either the account is reported as
# not configured rather than failing opaquely.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=


# Optional HTTPS for the hub (same port). Required for true PWA install on phones
# that open the hub by LAN IP (http://192.168.x.x is not a secure context).
# Point both paths at PEM files mounted into the container/host.
# JIRAN_TLS_CERT=/certs/fullchain.pem
# JIRAN_TLS_KEY=/certs/privkey.pem
# JIRAN_TLS_CA=/certs/chain.pem
