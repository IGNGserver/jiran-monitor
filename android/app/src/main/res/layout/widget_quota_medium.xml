<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/widget_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="13dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/widget_brand_mark"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:background="@drawable/widget_mark_bg"
        android:contentDescription="@null" />

      <TextView
        android:id="@+id/widget_eyebrow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.10"
        android:maxLines="1"
        android:text="额度 · LIMITS"
        android:textColor="@android:color/black"
        android:textSize="8sp" />

      <FrameLayout
        android:layout_width="84dp"
        android:layout_height="17dp">

        <ImageView
          android:id="@+id/quota_badge_bg"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_preview_badge" />

        <TextView
          android:id="@+id/quota_badge"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:fontFamily="sans-serif-medium"
          android:gravity="center"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="1 项告急"
          android:textColor="@android:color/black"
          android:textSize="7.5sp" />
      </FrameLayout>

      <ImageView
        android:id="@+id/widget_refresh"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="3dp"
        android:contentDescription="@string/widget_refresh"
        android:padding="4dp"
        android:src="@drawable/fluent_arrow_clockwise" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/quota_row_1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/quota_icon_1"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="bottom"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/quota_name_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Cursor"
            android:textColor="@android:color/black"
            android:textSize="9.5sp" />

          <TextView
            android:id="@+id/quota_plan_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Pro · 月度"
            android:textColor="@android:color/darker_gray"
            android:textSize="7sp" />
        </LinearLayout>

        <ImageView
          android:id="@+id/quota_bar_1"
          android:layout_width="match_parent"
          android:layout_height="3dp"
          android:layout_marginTop="3dp"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_preview_bar" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
          android:id="@+id/quota_remaining_1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:gravity="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="剩余 8%"
          android:textColor="@android:color/black"
          android:textSize="9.5sp" />

        <TextView
          android:id="@+id/quota_reset_1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:fontFamily="sans-serif"
          android:fontFeatureSettings="tnum"
          android:gravity="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="11月01日"
          android:textColor="@android:color/darker_gray"
          android:textSize="6.5sp" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/quota_row_2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/quota_icon_2"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="bottom"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/quota_name_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Codex"
            android:textColor="@android:color/black"
            android:textSize="9.5sp" />

          <TextView
            android:id="@+id/quota_plan_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Plus · 每周"
            android:textColor="@android:color/darker_gray"
            android:textSize="7sp" />
        </LinearLayout>

        <ImageView
          android:id="@+id/quota_bar_2"
          android:layout_width="match_parent"
          android:layout_height="3dp"
          android:layout_marginTop="3dp"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_preview_bar" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
          android:id="@+id/quota_remaining_2"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:gravity="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="剩余 43%"
          android:textColor="@android:color/black"
          android:textSize="9.5sp" />

        <TextView
          android:id="@+id/quota_reset_2"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:fontFamily="sans-serif"
          android:fontFeatureSettings="tnum"
          android:gravity="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="周四 09:00"
          android:textColor="@android:color/darker_gray"
          android:textSize="6.5sp" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/quota_row_3"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <ImageView
        android:id="@+id/quota_icon_3"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="bottom"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/quota_name_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Claude"
            android:textColor="@android:color/black"
            android:textSize="9.5sp" />

          <TextView
            android:id="@+id/quota_plan_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Max · 每周"
            android:textColor="@android:color/darker_gray"
            android:textSize="7sp" />
        </LinearLayout>

        <ImageView
          android:id="@+id/quota_bar_3"
          android:layout_width="match_parent"
          android:layout_height="3dp"
          android:layout_marginTop="3dp"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_preview_bar" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
          android:id="@+id/quota_remaining_3"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:gravity="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="剩余 62%"
          android:textColor="@android:color/black"
          android:textSize="9.5sp" />

        <TextView
          android:id="@+id/quota_reset_3"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:fontFamily="sans-serif"
          android:fontFeatureSettings="tnum"
          android:gravity="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="周五 18:00"
          android:textColor="@android:color/darker_gray"
          android:textSize="6.5sp" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/quota_row_4"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <ImageView
        android:id="@+id/quota_icon_4"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="bottom"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/quota_name_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Claude"
            android:textColor="@android:color/black"
            android:textSize="9.5sp" />

          <TextView
            android:id="@+id/quota_plan_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Max · 每周"
            android:textColor="@android:color/darker_gray"
            android:textSize="7sp" />
        </LinearLayout>

        <ImageView
          android:id="@+id/quota_bar_4"
          android:layout_width="match_parent"
          android:layout_height="3dp"
          android:layout_marginTop="3dp"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_preview_bar" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
          android:id="@+id/quota_remaining_4"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:gravity="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="剩余 62%"
          android:textColor="@android:color/black"
          android:textSize="9.5sp" />

        <TextView
          android:id="@+id/quota_reset_4"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:fontFamily="sans-serif"
          android:fontFeatureSettings="tnum"
          android:gravity="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="周五 18:00"
          android:textColor="@android:color/darker_gray"
          android:textSize="6.5sp" />
      </LinearLayout>
    </LinearLayout>

    <Space
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <TextView
      android:id="@+id/widget_state_line"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="同步于 5 分钟前"
      android:textColor="@android:color/darker_gray"
      android:textSize="7sp" />
  </LinearLayout>
</FrameLayout>
