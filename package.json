{
  "name": "jiran",
  "productName": "Jiran",
  "version": "1.0.3",
  "description": "Local-first token, cost and plan-quota monitoring for AI coding tools — desktop app, Docker Compose Hub, headless agent, Android read client.",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "agent": "node src/agent/agent.js",
    "agent:once": "node src/agent/agent.js --once",
    "evidence:qodercn": "node scripts/collect-qoder-cn-evidence.js",
    "migrate": "node migrations/run.js",
    "test:mysql": "node scripts/run-mysql-tests.js",
    "dev": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "update:hub-build": "node scripts/update-hub-build.js",
    "pack": "electron-builder --config scripts/electron-builder.config.js --dir",
    "dist:mac": "electron-builder --config scripts/electron-builder.config.js --mac --arm64 --publish never",
    "dist:mac:x64": "electron-builder --config scripts/electron-builder.config.js --mac --x64 --publish never",
    "dist:win": "electron-builder --config scripts/electron-builder.config.js --win --x64 --publish never",
    "dist:linux": "electron-builder --config scripts/electron-builder.config.js --linux --x64 --publish never",
    "verify:deb": "node scripts/verify-deb-package.js",
    "build:apt": "node scripts/build-apt-repository.js",
    "verify:release-artifact-names": "node scripts/verify-updater-artifact-names.js dist",
    "verify:release-version": "node scripts/verify-release-version.js",
    "package:headless": "node scripts/package-headless.js",
    "package:hub-compose": "node scripts/package-hub-compose.js",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "verify": "npm run verify:product-scope && npm run verify:shared-ui && npm run verify:css-vars && npm run verify:android-fluent-contrast && npm run verify:android-fluent-boundary && npm run lint && npm test",
    "dist:win:dir": "electron-builder --config scripts/electron-builder.config.js --win dir --x64 --publish never",
    "dist:win:prepackaged": "electron-builder --config scripts/electron-builder.config.js --prepackaged dist/win-unpacked --win nsis portable --x64 --publish never",
    "verify:product-scope": "node scripts/verify-product-scope.js",
    "verify:shared-ui": "node scripts/verify-shared-ui-boundary.js",
    "verify:css-vars": "node scripts/verify-renderer-css-vars.js",
    "verify:android-fluent-contrast": "node scripts/verify-android-fluent-contrast.js",
    "verify:android-fluent-boundary": "node scripts/verify-android-fluent-boundary.js",
    "verify:android": "npm run verify:android-fluent-contrast && npm run verify:android-fluent-boundary",
    "update:fluent-assets": "node scripts/update-fluent-assets.js"
  },
  "build": {
    "appId": "com.igng.tokenmonitor",
    "productName": "Jiran",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/electron/**/*",
      "src/shared/**/*",
      "src/shared-ui/**/*",
      "assets/icon.png",
      "assets/icons/**/*",
      "package.json",
      "!node_modules/**/*.map",
      "!node_modules/**/{docs,doc,example,examples,test,tests,benchmark,benchmarks}/**",
      "!node_modules/**/*.{md,markdown,h,hh,hpp,c,cc,cpp}",
      "!node_modules/mysql2/**",
      "!node_modules/iconv-lite/**",
      "!node_modules/aws-ssl-profiles/**",
      "!node_modules/long/**",
      "!node_modules/sql-escaper/**",
      "!node_modules/safer-buffer/**",
      "!node_modules/denque/**",
      "!node_modules/lru.min/**",
      "!node_modules/is-property/**",
      "!node_modules/generate-function/**",
      "!node_modules/named-placeholders/**",
      "!node_modules/@types/**"
    ],
    "asarUnpack": [
      "node_modules/@tokscale/**/*",
      "node_modules/tokscale/**/*",
      "node_modules/koffi/**/*"
    ],
    "mac": {
      "artifactName": "Jiran-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "forceCodeSigning": false,
      "minimumSystemVersion": "12.0",
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-win.png",
      "verifyUpdateCodeSignature": true,
      "signtoolOptions": {
        "publisherName": "SignPath Foundation"
      }
    },
    "linux": {
      "artifactName": "Jiran-${version}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "IGNGserver <176017966+IGNGserver@users.noreply.github.com>",
      "category": "Development",
      "icon": "assets/icon.png",
      "synopsis": "Local-first token, cost and plan-quota monitor for AI coding tools",
      "description": "Real-time token, cost and plan-quota monitoring across Claude Code, Codex, OpenCode and more, with an optional self-hosted multi-device Hub."
    },
    "nsis": {
      "artifactName": "Jiran-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "Jiran-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "IGNGserver",
        "repo": "jiran"
      }
    ]
  },
  "keywords": [
    "tokscale",
    "claude-code",
    "codex",
    "hermes",
    "jiran",
    "token-usage",
    "cost-tracking",
    "llm",
    "ai-tools",
    "electron",
    "desktop-app",
    "local-first",
    "self-hosted"
  ],
  "author": "IGNGserver",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IGNGserver/jiran.git"
  },
  "homepage": "https://github.com/IGNGserver/jiran#readme",
  "bugs": {
    "url": "https://github.com/IGNGserver/jiran/issues"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "dotenv": "^17.4.2",
    "electron-updater": "6.8.9",
    "koffi": "^3.1.4",
    "mysql2": "^3.24.4",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "tokscale": "^4.17.0",
    "undici": "^7.29.1"
  },
  "overrides": {
    "@discordjs/rest": {
      "undici": "6.28.1"
    }
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@fluentui/svg-icons": "^1.1.343",
    "@fluentui/web-components": "3.1.3",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.8.0",
    "globals": "^17.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
